[Unit]
Description=Auto-switch EliteBook thermal profile for Steam games
Documentation=https://github.com/matteopasseri407/hp-elitebook-845-g8-ryzen-tuning
After=elitebook-thermal-profile.service
Wants=elitebook-thermal-profile.service

[Service]
Type=simple
Environment=ELITEBOOK_LOW_BATTERY_THRESHOLD=20
Environment=ELITEBOOK_STEAM_WATCH_INTERVAL_AC=30
Environment=ELITEBOOK_STEAM_WATCH_INTERVAL_BATTERY=120
Environment=ELITEBOOK_STEAM_WATCH_INTERVAL_ACTIVE=20
ExecStart=/usr/local/sbin/elitebook-steam-game-watcher watch
Restart=on-failure
RestartSec=5s
Nice=10
IOSchedulingClass=idle
CPUQuota=2%
MemoryMax=64M

# Hardening. ProtectKernelTunables is intentionally left off because the
# watcher shells out to elitebook-thermal-profile, which writes EPP and
# frequency hints under /sys; the child process inherits this restriction.
NoNewPrivileges=yes
CapabilityBoundingSet=CAP_SYS_RAWIO CAP_SYS_NICE CAP_DAC_OVERRIDE
AmbientCapabilities=
ProtectSystem=strict
ReadWritePaths=/run/elitebook-thermal-profile
ProtectHome=yes
PrivateNetwork=yes
PrivateTmp=yes
RestrictAddressFamilies=AF_UNIX
IPAddressDeny=any
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallFilter=~@privileged @resources @debug @mount @swap @reboot
MemoryDenyWriteExecute=yes
ProtectClock=yes
ProtectHostname=yes
ProtectKernelLogs=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
KeyringMode=private
DevicePolicy=closed
DeviceAllow=/dev/mem rw
DeviceAllow=/dev/ryzen_smu rw
UMask=0077
RemoveIPC=yes

[Install]
WantedBy=multi-user.target
