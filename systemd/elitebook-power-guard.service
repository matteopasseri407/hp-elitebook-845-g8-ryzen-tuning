[Unit]
Description=Verify and repair EliteBook thermal profile guardrails
Documentation=https://github.com/matteopasseri407/hp-elitebook-845-g8-ryzen-tuning
After=multi-user.target tuned.service
Wants=tuned.service

[Service]
Type=oneshot
ExecStart=/usr/local/sbin/elitebook-power-guard repair
TimeoutStartSec=90s

# This service intentionally keeps write access to the host system because its
# job is to remask conflicting power profile units after package changes.
NoNewPrivileges=yes
CapabilityBoundingSet=CAP_SYS_RAWIO CAP_SYS_NICE CAP_DAC_OVERRIDE
AmbientCapabilities=
ProtectSystem=strict
ReadWritePaths=/etc/systemd/system /run/elitebook-thermal-profile
ProtectHome=yes
PrivateNetwork=yes
PrivateTmp=yes
RestrictAddressFamilies=AF_UNIX
IPAddressDeny=any
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallFilter=~@privileged @resources @debug @mount @swap @reboot
MemoryDenyWriteExecute=yes
ProtectClock=yes
ProtectHostname=yes
ProtectKernelLogs=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
ProtectProc=invisible
KeyringMode=private
DevicePolicy=closed
DeviceAllow=/dev/mem rw
DeviceAllow=/dev/ryzen_smu rw
UMask=0077
