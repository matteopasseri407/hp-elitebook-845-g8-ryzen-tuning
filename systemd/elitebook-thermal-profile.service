[Unit]
Description=Apply HP EliteBook 845 G8 Ryzen thermal profile
Documentation=https://github.com/matteopasseri407/hp-elitebook-845-g8-ryzen-tuning
After=tuned.service
Wants=tuned.service

[Service]
Type=oneshot
Environment=ELITEBOOK_PROFILE_SOURCE=system-auto
Environment=ELITEBOOK_LOW_BATTERY_THRESHOLD=20
ExecStart=/usr/local/sbin/elitebook-thermal-profile auto
RuntimeDirectory=elitebook-thermal-profile
RuntimeDirectoryMode=0755
RuntimeDirectoryPreserve=yes

# Hardening. ProtectKernelTunables is intentionally left off because the
# script writes CPU policy hints under /sys/devices/system/cpu/cpufreq.
NoNewPrivileges=yes
ProtectSystem=strict
ReadWritePaths=/run/elitebook-thermal-profile
ProtectHome=yes
PrivateTmp=yes
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
SystemCallArchitectures=native
ProtectKernelLogs=yes
ProtectKernelModules=yes
ProtectControlGroups=yes

[Install]
WantedBy=multi-user.target
