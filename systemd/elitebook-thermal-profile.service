[Unit]
Description=HP EliteBook 845 G8 Ryzen thermal profile daemon
Documentation=https://github.com/matteopasseri407/hp-elitebook-845-g8-ryzen-tuning
# On Fedora the daemon also selects tuned profiles.
After=tuned.service
Wants=tuned.service
# A daemon that keeps crashing should stop retrying instead of spending
# battery on restarts; the power guard timer starts it again later.
StartLimitIntervalSec=600
StartLimitBurst=10

[Service]
# The daemon is the only writer of power settings: it follows the power
# source, the battery level, idle time and Steam games, and rewrites every
# setting hourly and after a resume. CLI commands reach it over a root-only
# socket in the runtime directory.
Type=notify
NotifyAccess=main
ExecStart=/usr/local/sbin/elitebook-thermal-profile daemon
Restart=on-failure
RestartSec=5s
# Exit 78 (EX_CONFIG): unsupported hardware or a bad RYZENADJ path.
RestartPreventExitStatus=78
WatchdogSec=30s
Environment=ELITEBOOK_LOW_BATTERY_THRESHOLD=20
Environment=ELITEBOOK_IDLE_SAMPLE_INTERVAL=1
Environment=ELITEBOOK_STEAM_WATCH_INTERVAL_AC=30
Environment=ELITEBOOK_STEAM_WATCH_INTERVAL_BATTERY=120
Environment=ELITEBOOK_STEAM_WATCH_INTERVAL_ACTIVE=20
RuntimeDirectory=elitebook-thermal-profile
RuntimeDirectoryMode=0755
RuntimeDirectoryPreserve=yes
Nice=10
IOSchedulingClass=idle
# Headroom for the RyzenAdj and tuned-adm children it starts.
CPUQuota=10%
MemoryMax=64M

# Hardening. ProtectKernelTunables is intentionally left off because the
# daemon writes CPU policy, PCI runtime PM and panel power hints under /sys.
NoNewPrivileges=yes
# RyzenAdj's fallback path needs raw I/O plus PCI config access; reading a
# Steam game's environment in /proc needs CAP_SYS_PTRACE.
CapabilityBoundingSet=CAP_SYS_ADMIN CAP_SYS_RAWIO CAP_SYS_NICE CAP_DAC_OVERRIDE CAP_SYS_PTRACE
AmbientCapabilities=
ProtectSystem=strict
ReadWritePaths=/run/elitebook-thermal-profile
ProtectHome=yes
# No PrivateNetwork: the kernel sends power supply uevents only into the host
# network namespace. IP traffic stays blocked by IPAddressDeny and the
# address family list.
PrivateTmp=yes
RestrictAddressFamilies=AF_UNIX AF_NETLINK
IPAddressDeny=any
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallFilter=~@privileged @resources @debug @mount @swap @reboot
MemoryDenyWriteExecute=yes
ProtectClock=yes
ProtectHostname=yes
ProtectKernelLogs=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
KeyringMode=private
DevicePolicy=closed
DeviceAllow=/dev/mem rw
DeviceAllow=/dev/ryzen_smu rw
UMask=0077
RemoveIPC=yes

[Install]
WantedBy=multi-user.target
