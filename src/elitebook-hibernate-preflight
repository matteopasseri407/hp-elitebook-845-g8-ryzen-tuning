#!/usr/bin/env python3
# SPDX-License-Identifier: GPL-3.0-or-later
"""Preflight validation for btrfs swapfile hibernation on HP EliteBook Ryzen systems.

Validates the btrfs swapfile hibernate setup before systemd enters hibernate:
swapfile presence and size, SELinux label, resume offset, kernel lockdown,
and resume= kernel arguments on both the default boot entry and the running
kernel. On success it programs /sys/power/resume, resume_offset and
image_size so the hibernate image lands in the verified swapfile.
"""

from __future__ import annotations

import os
import shutil
import subprocess
import sys
import typing
from pathlib import Path

sys.path.insert(0, os.path.dirname(os.path.abspath(__file__)))

import elitebook_common as common  # noqa: E402


def usage() -> None:
    sys.stderr.write(
        "Usage: elitebook-hibernate-preflight [hibernate|suspend-then-hibernate|check-config]\n\n"
        "Validates the btrfs swapfile hibernate setup before systemd enters hibernate:\n"
        "swapfile presence and size, SELinux label, resume offset, kernel lockdown,\n"
        "and resume= kernel arguments on both the default boot entry and the running\n"
        "kernel. On success it programs /sys/power/resume, resume_offset and\n"
        "image_size so the hibernate image lands in the verified swapfile.\n\n"
        "check-config only validates that the configuration file is complete; it does\n"
        "not require the swapfile or touch /sys/power.\n\n"
        "Configuration is read from /etc/elitebook-hibernate.conf (override with\n"
        "ELITEBOOK_HIBERNATE_CONF). See config/elitebook-hibernate.conf.example.\n"
    )


def log(msg: str) -> None:
    sys.stderr.write(f"elitebook-hibernate-preflight: {msg}\n")


def fail(msg: str) -> typing.NoReturn:
    log(f"FAILED: {msg}")
    sys.exit(1)


def require_file(path: str | Path) -> None:
    p = Path(path)
    if not p.exists():
        fail(f"missing {path}")


def require_command(cmd: str, hint: str) -> None:
    if shutil.which(cmd) is None:
        fail(f"missing required command '{cmd}' ({hint})")


def parse_config(config_path: Path) -> dict[str, str]:
    require_file(config_path)
    config: dict[str, str] = {}
    try:
        text = config_path.read_text(encoding="utf-8", errors="ignore")
    except OSError as e:
        fail(f"could not read {config_path}: {e}")

    for line in text.splitlines():
        line = line.strip()
        if not line or line.startswith("#"):
            continue
        if "=" in line:
            key, val = line.split("=", 1)
            key = key.strip()
            val = val.strip().strip('"').strip("'")
            config[key] = val

    for required in ("SWAPFILE", "RESUME_UUID", "RESUME_OFFSET", "IMAGE_SIZE_BYTES"):
        if not config.get(required):
            fail(f"missing {required} in {config_path}")

    swapfile = config["SWAPFILE"]
    if not swapfile.startswith("/"):
        fail(f"SWAPFILE must be an absolute path, got '{swapfile}'")

    if not common.is_uint(config["RESUME_OFFSET"]):
        fail(f"RESUME_OFFSET must be an integer, got '{config['RESUME_OFFSET']}'")

    if not common.is_uint(config["IMAGE_SIZE_BYTES"]):
        fail(f"IMAGE_SIZE_BYTES must be an integer, got '{config['IMAGE_SIZE_BYTES']}'")

    return config


def main(argv: list[str] | None = None) -> int:
    if argv is None:
        argv = sys.argv[1:]

    mode = argv[0] if argv else "hibernate"
    if mode in ("-h", "--help"):
        usage()
        return 0
    if mode not in ("hibernate", "suspend-then-hibernate", "check-config"):
        usage()
        return 2

    config_path = Path(
        os.environ.get("ELITEBOOK_HIBERNATE_CONF", "/etc/elitebook-hibernate.conf")
    )
    config = parse_config(config_path)

    swapfile = config["SWAPFILE"]
    resume_uuid = config["RESUME_UUID"]
    resume_offset = config["RESUME_OFFSET"]
    image_size_bytes = config["IMAGE_SIZE_BYTES"]

    if mode == "check-config":
        log(
            f"ok config={config_path} swapfile={swapfile} uuid={resume_uuid} "
            f"offset={resume_offset} image_size={image_size_bytes}"
        )
        return 0

    require_command(
        "btrfs", "btrfs-progs is required to verify the swapfile resume offset"
    )
    require_command(
        "grubby",
        "grubby is required to verify the default boot entry; this preflight currently targets Fedora-style boot configs",
    )
    require_command("swapon", "util-linux is required to inspect active swap")

    require_file("/sys/power/state")
    require_file("/sys/power/disk")
    require_file("/sys/power/resume")
    require_file("/sys/power/resume_offset")
    require_file("/sys/power/image_size")
    require_file(swapfile)

    power_state = common.read_trimmed(Path("/sys/power/state")).split()
    if "disk" not in power_state:
        fail("kernel does not expose disk sleep state")

    power_disk = common.read_trimmed(Path("/sys/power/disk")).split()
    if "shutdown" not in power_disk:
        fail("kernel does not expose shutdown hibernate mode")

    lockdown_path = Path("/sys/kernel/security/lockdown")
    if lockdown_path.is_file():
        lockdown_mode = common.kernel_lockdown_mode(lockdown_path)
        if lockdown_mode != "none":
            fail(f"kernel lockdown is active: {common.read_trimmed(lockdown_path)}")

    if shutil.which("getenforce"):
        try:
            ge = subprocess.run(
                ["getenforce"], capture_output=True, text=True, check=False
            )
            if ge.stdout.strip() == "Enforcing":
                ls_out = subprocess.run(
                    ["ls", "-Zd", swapfile], capture_output=True, text=True, check=False
                )
                label = (
                    ls_out.stdout.strip().split()[0] if ls_out.stdout.strip() else ""
                )
                parts = label.split(":")
                swapfile_type = parts[2] if len(parts) >= 3 else ""
                if swapfile_type != "swapfile_t":
                    fail(
                        f"{swapfile} SELinux type is {swapfile_type}; expected swapfile_t"
                    )
        except OSError:
            pass

    try:
        sw_proc = subprocess.run(
            ["swapon", "--show=NAME,SIZE", "--bytes", "--noheadings"],
            capture_output=True,
            text=True,
            check=False,
        )
        swap_bytes: int | None = None
        for s_line in sw_proc.stdout.splitlines():
            fields = s_line.split()
            if (
                fields
                and fields[0] == swapfile
                and len(fields) >= 2
                and common.is_uint(fields[1])
            ):
                swap_bytes = int(fields[1])
                break
        if swap_bytes is None:
            fail(f"{swapfile} is not active swap")
        min_swap_bytes = int(image_size_bytes) + 2147483648
        if swap_bytes < min_swap_bytes:
            fail(f"{swapfile} is too small: {swap_bytes}B < {min_swap_bytes}B")
    except OSError as e:
        fail(f"could not inspect active swap: {e}")

    try:
        btrfs_proc = subprocess.run(
            ["btrfs", "inspect-internal", "map-swapfile", "-r", swapfile],
            capture_output=True,
            text=True,
            check=False,
        )
        actual_offset = btrfs_proc.stdout.strip()
        if actual_offset != resume_offset:
            fail(
                f"resume offset changed: actual={actual_offset} configured={resume_offset}"
            )
    except OSError as e:
        fail(f"could not run btrfs inspect-internal: {e}")

    resume_dev = Path(f"/dev/disk/by-uuid/{resume_uuid}")
    require_file(resume_dev)
    try:
        real_dev = os.path.realpath(resume_dev)
        st = os.stat(real_dev)
        major = os.major(st.st_rdev)
        minor = os.minor(st.st_rdev)
        resume_majmin = f"{major}:{minor}"
    except OSError as e:
        fail(f"could not stat resume device {resume_dev}: {e}")

    try:
        grubby_proc = subprocess.run(
            ["grubby", "--info=DEFAULT"],
            capture_output=True,
            text=True,
            check=False,
        )
        default_args: str | None = None
        for g_line in grubby_proc.stdout.splitlines():
            if g_line.startswith('args="') and g_line.endswith('"'):
                default_args = g_line[6:-1]
                break
        if default_args is None:
            fail("could not read kernel args from the default grubby boot entry")
        if f"resume=UUID={resume_uuid}" not in default_args:
            fail(f"default boot entry lacks resume=UUID={resume_uuid}")
        if f"resume_offset={resume_offset}" not in default_args:
            fail(f"default boot entry lacks resume_offset={resume_offset}")
    except OSError as e:
        fail(f"could not run grubby: {e}")

    running_args = common.read_trimmed(Path("/proc/cmdline"))
    if f"resume=UUID={resume_uuid}" not in running_args:
        fail(f"running kernel lacks resume=UUID={resume_uuid}; reboot before hibernate")
    if f"resume_offset={resume_offset}" not in running_args:
        fail(
            f"running kernel lacks resume_offset={resume_offset}; reboot before hibernate"
        )

    try:
        Path("/sys/power/resume").write_text(f"{resume_majmin}\n", encoding="utf-8")
        Path("/sys/power/resume_offset").write_text(
            f"{resume_offset}\n", encoding="utf-8"
        )
        Path("/sys/power/image_size").write_text(
            f"{image_size_bytes}\n", encoding="utf-8"
        )
    except OSError as e:
        fail(f"could not program sysfs power attributes: {e}")

    if common.read_trimmed(Path("/sys/power/resume")) != resume_majmin:
        fail(f"failed to set /sys/power/resume to {resume_majmin}")
    if common.read_trimmed(Path("/sys/power/resume_offset")) != resume_offset:
        fail(f"failed to set /sys/power/resume_offset to {resume_offset}")

    log(
        f"ok mode={mode} resume={resume_majmin} offset={resume_offset} "
        f"image_size={image_size_bytes} swap={swap_bytes}B"
    )
    return 0


if __name__ == "__main__":
    sys.exit(main())
