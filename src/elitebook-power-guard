#!/usr/bin/env python3
# SPDX-License-Identifier: GPL-3.0-or-later
"""Watchdog and integrity guard for the EliteBook thermal profile stack.

Verifies and repairs local invariants needed by the EliteBook thermal profiles:
masking conflicting power daemons, ensuring active units, checking hardware
compatibility, validating sysfs cpufreq driver, and reporting thermal headroom.
"""

from __future__ import annotations

import os
import subprocess
import sys
from datetime import datetime
from pathlib import Path

# Modules sit next to the script in a source install and in a private
# library directory in the distribution packages.
for _lib in (
    "/usr/lib/elitebook-thermal-profile",
    os.path.dirname(os.path.abspath(__file__)),
):
    if _lib not in sys.path:
        sys.path.insert(0, _lib)

import elitebook_common as common  # noqa: E402

MASKED_UNITS = (
    "tuned-ppd.service",
    "power-profiles-daemon.service",
)

ENABLED_UNITS = ("elitebook-thermal-profile.service",)

DAEMON_UNIT = "elitebook-thermal-profile.service"

# Components of the pre-daemon design. Left running, each would be a second
# writer of the same power settings, so the guard stops them.
LEGACY_UNITS = (
    "elitebook-idle-watcher.service",
    "elitebook-steam-game-watcher.service",
)


def usage() -> None:
    sys.stderr.write(
        "Usage: elitebook-power-guard [check|repair]\n\n"
        "check   Verify guardrails and exit non-zero if anything is wrong.\n"
        "repair  Reapply safe guardrails, start missing services, and reapply auto.\n\n"
        "This guard intentionally does not pin kernels or block distribution updates.\n"
        "It only repairs the local invariants needed by the EliteBook thermal profiles.\n"
    )


def log(msg: str) -> None:
    print(f"elitebook-power-guard: {msg}")


def warn(issues: list[str], msg: str) -> None:
    issues.append(msg)
    log(f"WARN: {msg}")


def unit_exists(unit: str) -> bool:
    try:
        res = subprocess.run(
            ["systemctl", "cat", unit],
            stdout=subprocess.DEVNULL,
            stderr=subprocess.DEVNULL,
            check=False,
        )
        return res.returncode == 0
    except OSError:
        return False


def unit_enabled_state(unit: str) -> str:
    try:
        res = subprocess.run(
            ["systemctl", "is-enabled", unit],
            stdout=subprocess.PIPE,
            stderr=subprocess.DEVNULL,
            text=True,
            check=False,
        )
        return res.stdout.strip()
    except OSError:
        return ""


def unit_active_state(unit: str) -> str:
    try:
        res = subprocess.run(
            ["systemctl", "is-active", unit],
            stdout=subprocess.PIPE,
            stderr=subprocess.DEVNULL,
            text=True,
            check=False,
        )
        return res.stdout.strip()
    except OSError:
        return ""


def os_release_family(os_release_path: Path) -> str:
    id_val = ""
    id_like_val = ""
    try:
        text = os_release_path.read_text(encoding="utf-8", errors="ignore")
        for line in text.splitlines():
            line = line.strip()
            if line.startswith("#") or "=" not in line:
                continue
            k, v = line.split("=", 1)
            k = k.strip()
            v = v.strip().strip('"').strip("'")
            if k == "ID":
                id_val = v
            elif k == "ID_LIKE":
                id_like_val = v
    except OSError:
        pass
    return f"{id_val} {id_like_val}".strip()


def detect_expected_backend(os_release_path: Path) -> str:
    family = f" {os_release_family(os_release_path)} "
    for distro in (" fedora ", " rhel ", " centos "):
        if distro in family:
            return "tuned"
    if unit_exists("tuned.service"):
        return "tuned"
    return "none"


def configured_power_backend(backend_conf: Path, os_release_path: Path) -> str:
    configured = ""
    try:
        text = backend_conf.read_text(encoding="utf-8", errors="ignore")
        for line in text.splitlines():
            line = line.strip()
            if line.startswith("#") or "=" not in line:
                continue
            k, v = line.split("=", 1)
            if k.strip() == "POWER_BACKEND":
                configured = v.strip().strip('"').strip("'")
    except OSError:
        pass

    if configured in ("tuned", "none"):
        return configured
    return detect_expected_backend(os_release_path)


def write_guard_state(
    status: str,
    mode: str,
    issues: list[str],
    changed: int,
    state_dir: Path,
    guard_state_file: Path,
) -> None:
    now = datetime.now().astimezone().isoformat(timespec="seconds")
    lines = [
        f"status={status}",
        f"mode={mode}",
        f"issues={len(issues)}",
        f"changed={changed}",
        f"updated={now}",
    ]
    if issues:
        lines.append(f"details={issues[0]}")
    try:
        common.write_atomic(guard_state_file, "\n".join(lines) + "\n")
    except OSError:
        pass


def ensure_masked_units(mode: str, issues: list[str]) -> int:
    changed = 0
    for unit in MASKED_UNITS:
        state = unit_enabled_state(unit)
        if state == "masked":
            continue
        if not unit_exists(unit):
            continue
        if mode == "check":
            warn(issues, f"{unit} is not masked")
            continue
        try:
            res = subprocess.run(
                ["systemctl", "mask", "--now", unit],
                stdout=subprocess.DEVNULL,
                stderr=subprocess.DEVNULL,
                check=False,
            )
            if res.returncode == 0:
                log(f"masked {unit}")
                changed = 1
            else:
                warn(issues, f"failed to mask {unit}")
        except OSError:
            warn(issues, f"failed to mask {unit}")
    return changed


def ensure_power_backend(
    mode: str,
    backend_conf: Path,
    os_release_path: Path,
    issues: list[str],
) -> int:
    changed = 0
    backend = configured_power_backend(backend_conf, os_release_path)
    if backend == "none":
        log(
            "no tuned backend configured; CPU policy is driven directly via sysfs and SMU"
        )
        return 0

    if not unit_exists("tuned.service"):
        warn(issues, "tuned.service is missing")
        return 0

    state = unit_enabled_state("tuned.service")
    if state != "enabled":
        if mode == "check":
            warn(issues, "tuned.service is not enabled")
        else:
            try:
                res = subprocess.run(
                    ["systemctl", "enable", "tuned.service"],
                    stdout=subprocess.DEVNULL,
                    stderr=subprocess.DEVNULL,
                    check=False,
                )
                if res.returncode == 0:
                    log("enabled tuned.service")
                    changed = 1
                else:
                    warn(issues, "failed to enable tuned.service")
            except OSError:
                warn(issues, "failed to enable tuned.service")

    state = unit_active_state("tuned.service")
    if state != "active":
        if mode == "check":
            warn(issues, "tuned.service is not active")
        else:
            try:
                res = subprocess.run(
                    ["systemctl", "start", "tuned.service"],
                    stdout=subprocess.DEVNULL,
                    stderr=subprocess.DEVNULL,
                    check=False,
                )
                if res.returncode == 0:
                    log("started tuned.service")
                    changed = 1
                else:
                    warn(issues, "failed to start tuned.service")
            except OSError:
                warn(issues, "failed to start tuned.service")
    return changed


def ensure_enabled_units(mode: str, issues: list[str]) -> int:
    changed = 0
    for unit in ENABLED_UNITS:
        if not unit_exists(unit):
            warn(issues, f"{unit} is missing")
            continue
        state = unit_enabled_state(unit)
        if state == "enabled":
            continue
        if mode == "check":
            warn(issues, f"{unit} is not enabled")
        else:
            try:
                res = subprocess.run(
                    ["systemctl", "enable", unit],
                    stdout=subprocess.DEVNULL,
                    stderr=subprocess.DEVNULL,
                    check=False,
                )
                if res.returncode == 0:
                    log(f"enabled {unit}")
                    changed = 1
                else:
                    warn(issues, f"failed to enable {unit}")
            except OSError:
                warn(issues, f"failed to enable {unit}")
    return changed


def ensure_legacy_units_stopped(mode: str, issues: list[str]) -> int:
    changed = 0
    for unit in LEGACY_UNITS:
        if not unit_exists(unit):
            continue
        state = unit_enabled_state(unit)
        active = unit_active_state(unit)
        if state not in ("enabled", "enabled-runtime") and active != "active":
            continue
        if mode == "check":
            warn(issues, f"legacy {unit} is still installed and running or enabled")
            continue
        try:
            res = subprocess.run(
                ["systemctl", "disable", "--now", unit],
                stdout=subprocess.DEVNULL,
                stderr=subprocess.DEVNULL,
                check=False,
            )
            if res.returncode == 0:
                log(f"disabled legacy {unit}")
                changed = 1
            else:
                warn(issues, f"failed to disable legacy {unit}")
        except OSError:
            warn(issues, f"failed to disable legacy {unit}")
    return changed


def ensure_daemon_active(mode: str, issues: list[str]) -> int:
    if not unit_exists(DAEMON_UNIT):
        return 0
    if unit_active_state(DAEMON_UNIT) == "active":
        return 0
    if mode == "check":
        warn(issues, f"{DAEMON_UNIT} is not active")
        return 0
    try:
        res = subprocess.run(
            ["systemctl", "start", DAEMON_UNIT],
            stdout=subprocess.DEVNULL,
            stderr=subprocess.DEVNULL,
            timeout=60,
            check=False,
        )
        if res.returncode == 0:
            log(f"started {DAEMON_UNIT}")
            return 1
    except (OSError, subprocess.SubprocessError):
        pass
    warn(issues, f"failed to start {DAEMON_UNIT}")
    return 0


def check_static_files(
    thermal_profile: Path,
    legacy_files: tuple[Path, ...],
    issues: list[str],
) -> None:
    if not (thermal_profile.is_file() and os.access(thermal_profile, os.X_OK)):
        warn(issues, f"{thermal_profile} is missing or not executable")
    for legacy in legacy_files:
        if legacy.exists():
            warn(
                issues,
                f"{legacy} is left over from an older version and still triggers "
                "profile changes; reinstall or remove it",
            )
    if (
        common.find_ryzenadj(
            "",
            [
                "/usr/local/sbin/ryzenadj",
                "/usr/local/bin/ryzenadj",
                "/usr/bin/ryzenadj",
            ],
        )
        is None
    ):
        warn(
            issues,
            "RyzenAdj is missing from /usr/local/sbin, /usr/local/bin, and /usr/bin",
        )


def check_hardware_guard(thermal_profile: Path, issues: list[str]) -> None:
    if not (thermal_profile.is_file() and os.access(thermal_profile, os.X_OK)):
        return
    try:
        res = subprocess.run(
            [str(thermal_profile), "--check-hardware"],
            stdout=subprocess.DEVNULL,
            stderr=subprocess.DEVNULL,
            timeout=10,
            check=False,
        )
        if res.returncode != 0:
            warn(
                issues,
                "hardware guard failed; this machine no longer matches the supported EliteBook profile",
            )
    except (OSError, subprocess.SubprocessError):
        warn(
            issues,
            "hardware guard failed; this machine no longer matches the supported EliteBook profile",
        )


def check_cpufreq_shape(cpufreq_dir: Path, issues: list[str]) -> None:
    policies = sorted(cpufreq_dir.glob("policy*"))
    if not policies:
        warn(issues, "cpufreq policy sysfs is missing")
        return

    drivers_list: list[str] = []
    for policy in policies:
        driver_file = policy / "scaling_driver"
        if driver_file.is_file():
            val = common.read_trimmed(driver_file)
            if val and val not in drivers_list:
                drivers_list.append(val)
    drivers = ",".join(sorted(drivers_list))
    if "amd-pstate-epp" not in drivers:
        warn(
            issues,
            f"expected amd-pstate-epp cpufreq driver, found '{drivers or 'unknown'}'",
        )

    epp_missing = False
    for policy in policies:
        epp_file = policy / "energy_performance_preference"
        try:
            st = epp_file.stat()
            if not (st.st_mode & 0o200):
                epp_missing = True
                break
        except OSError:
            epp_missing = True
            break
    if epp_missing:
        warn(
            issues,
            "one or more cpufreq policies lack writable energy_performance_preference",
        )


def apply_sysfs_fallback(
    power_supply_dir: Path,
    cpufreq_dir: Path,
    state_dir: Path,
    issues: list[str],
) -> None:
    try:
        lock = common.acquire_dispatcher_lock(state_dir, 10.0)
    except TimeoutError:
        warn(issues, "could not acquire dispatcher lock within 10s for sysfs fallback")
        return

    try:
        on_ac = common.on_ac_power(power_supply_dir)
        if on_ac:
            label = "ac-fallback"
            boost = 1
            epp = "balance_power"
            max_freq = 3000000
        else:
            label = "battery-fallback"
            boost = 0
            epp = "power"
            max_freq = 1800000

        log(f"applying {label} direct sysfs fallback")

        common.apply_cpu_policy(
            cpufreq_dir, epp, "on" if boost == 1 else "off", str(max_freq)
        )

        now = datetime.now().astimezone().isoformat(timespec="seconds")
        content = (
            f"profile={label}\n"
            f"source=guard-fallback\n"
            f"epp={epp}\n"
            f"boost={'on' if boost == 1 else 'off'}\n"
            f"max_freq={max_freq}\n"
            f"updated={now}\n"
        )
        common.write_atomic(state_dir / "fallback", content)
    finally:
        lock.close()


def apply_auto_profile(
    mode: str,
    thermal_profile: Path,
    power_supply_dir: Path,
    cpufreq_dir: Path,
    state_dir: Path,
    issues: list[str],
) -> None:
    """Have the daemon rewrite every setting, or fall back to plain sysfs."""
    if mode != "repair":
        return
    if (
        unit_active_state(DAEMON_UNIT) == "active"
        and thermal_profile.is_file()
        and os.access(thermal_profile, os.X_OK)
    ):
        try:
            res = subprocess.run(
                [str(thermal_profile), "reassert"],
                stdout=subprocess.DEVNULL,
                stderr=subprocess.DEVNULL,
                timeout=60,
                check=False,
            )
            if res.returncode == 0:
                log("asked the daemon to reassert the thermal profile")
                return
        except (OSError, subprocess.SubprocessError):
            pass

    if unit_active_state(DAEMON_UNIT) == "active":
        # The daemon is running but did not answer. Writing sysfs behind its
        # back would make a second writer; report it and let it recover.
        warn(issues, "the thermal profile daemon did not answer a reassert request")
        return
    warn(issues, "failed to reapply the EliteBook thermal profile")
    apply_sysfs_fallback(power_supply_dir, cpufreq_dir, state_dir, issues)


def check_smu_state(state_dir: Path, issues: list[str]) -> None:
    current = state_dir / "current"
    state = common.read_key_value_file(current)
    smu = state.get("smu", "")
    if smu in ("ok", ""):
        return
    elif smu == "unavailable":
        warn(
            issues,
            "SMU limits are not being applied: RyzenAdj is not installed. CPU policy (EPP, boost, frequency) is still active.",
        )
    elif smu == "blocked":
        warn(
            issues,
            "SMU limits are blocked by kernel lockdown, which Secure Boot normally enables. CPU policy (EPP, boost, frequency) is still active.",
        )
    elif smu == "failed":
        warn(
            issues,
            "RyzenAdj ran but failed to apply SMU limits. CPU policy (EPP, boost, frequency) is still active.",
        )
    else:
        warn(issues, f"unrecognized SMU state '{smu}' in the dispatcher state file")


def check_thermal_headroom(
    state_dir: Path,
    min_samples: int,
    over_target_percent: int,
    issues: list[str],
) -> None:
    thermal_file = state_dir / "thermal"
    if not thermal_file.is_file():
        return
    record = common.read_key_value_file(thermal_file)
    samples_raw = record.get("samples")
    over_raw = record.get("over_target")
    target_raw = record.get("target_c")
    peak_raw = record.get("peak_c", "unknown")

    if not (
        common.is_uint(samples_raw)
        and common.is_uint(over_raw)
        and common.is_uint(target_raw)
    ):
        return

    assert samples_raw is not None and over_raw is not None and target_raw is not None
    samples = int(samples_raw)
    over = int(over_raw)
    target = int(target_raw)

    if target <= 0:
        return

    if samples < min_samples:
        return

    percent = (over * 100) // samples
    if percent >= over_target_percent:
        warn(
            issues,
            f"the active profile is not holding its thermal target: {percent}% of {samples} samples above {target} C, peak {peak_raw or 'unknown'} C. Consider lowering the sustained limit in the profile configuration.",
        )


def main(argv: list[str] | None = None) -> int:
    if argv is None:
        argv = sys.argv[1:]
    mode = argv[0] if argv else "repair"
    if mode in ("-h", "--help"):
        usage()
        return 0
    if mode not in ("check", "repair"):
        usage()
        return 2

    state_dir = Path(
        os.environ.get("ELITEBOOK_THERMAL_STATE_DIR", "/run/elitebook-thermal-profile")
    )
    guard_state_file = state_dir / "guard"
    power_supply_dir = Path(
        os.environ.get("ELITEBOOK_POWER_SUPPLY_DIR", "/sys/class/power_supply")
    )
    thermal_profile = Path(
        os.environ.get(
            "ELITEBOOK_THERMAL_PROFILE_BIN", "/usr/local/sbin/elitebook-thermal-profile"
        )
    )
    legacy_files = (
        Path("/etc/udev/rules.d/90-elitebook-thermal-profile.rules"),
        Path("/etc/systemd/system-sleep/elitebook-thermal-profile"),
    )
    backend_conf = Path(
        os.environ.get(
            "ELITEBOOK_BACKEND_CONF", "/etc/elitebook-thermal-profile/backend.conf"
        )
    )
    os_release = Path(os.environ.get("ELITEBOOK_OS_RELEASE", "/etc/os-release"))
    cpufreq_dir = Path("/sys/devices/system/cpu/cpufreq")
    min_samples = int(os.environ.get("ELITEBOOK_THERMAL_MIN_SAMPLES", "300"))
    over_target_percent = int(
        os.environ.get("ELITEBOOK_THERMAL_OVER_TARGET_PERCENT", "25")
    )

    issues: list[str] = []
    changed = 0

    changed += ensure_masked_units(mode, issues)
    changed += ensure_power_backend(mode, backend_conf, os_release, issues)
    changed += ensure_enabled_units(mode, issues)
    changed += ensure_legacy_units_stopped(mode, issues)
    check_static_files(thermal_profile, legacy_files, issues)
    check_hardware_guard(thermal_profile, issues)
    check_cpufreq_shape(cpufreq_dir, issues)
    changed += ensure_daemon_active(mode, issues)
    apply_auto_profile(
        mode, thermal_profile, power_supply_dir, cpufreq_dir, state_dir, issues
    )
    check_smu_state(state_dir, issues)
    check_thermal_headroom(state_dir, min_samples, over_target_percent, issues)

    status = "degraded" if issues else "ok"
    write_guard_state(status, mode, issues, changed, state_dir, guard_state_file)
    return 1 if issues else 0


if __name__ == "__main__":
    sys.exit(main())
