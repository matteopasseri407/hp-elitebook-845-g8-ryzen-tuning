def truthy(value: str | None) -> bool:
    return (value or "") in ("1", "true", "TRUE", "yes", "YES", "on", "ON")


def is_supported_product(product: str) -> bool:
    return any(sub in product for sub in SUPPORTED_PRODUCT_SUBSTRINGS)


def on_ac_power() -> bool:
    return common.on_ac_power(POWER_SUPPLY_DIR)


def battery_capacity() -> str | None:
    value = common.battery_capacity(POWER_SUPPLY_DIR)
    return None if value is None else str(value)


def battery_is_low() -> bool:
    threshold_raw = os.environ.get("ELITEBOOK_LOW_BATTERY_THRESHOLD", "20")
    if not common.is_uint(threshold_raw):
        die("ELITEBOOK_LOW_BATTERY_THRESHOLD must be an integer percentage")
    if int(threshold_raw) <= 0:
        return False
    if on_ac_power():
        return False
    capacity = battery_capacity()
    if capacity is None:
        return False
    return int(capacity) <= int(threshold_raw)


def cpu_temperature_c() -> str | None:
    value = common.cpu_temperature_c(HWMON_DIR)
    return None if value is None else str(value)


def read_key_value_file(path: Path) -> dict[str, str]:
    return common.read_key_value_file(path)


def current_value(key: str) -> str:
    return read_key_value_file(STATE_FILE).get(key, "")


def thermal_value(key: str) -> str:
    return read_key_value_file(THERMAL_FILE).get(key, "")


def print_thermal_record() -> None:
    if not THERMAL_FILE.is_file():
        try:
            THERMAL_FILE.stat()
        except OSError:
            return
    peak = thermal_value("peak_c")
    target = thermal_value("target_c")
    samples = thermal_value("samples")
    over = thermal_value("over_target")
    if not (common.is_uint(peak) and int(peak) > 0):
        return
    if common.is_uint(target) and int(target) > 0:
        print(
            f"Peak:         {peak} C since this profile was applied (target {target} C)"
        )
    else:
        print(f"Peak:         {peak} C since this profile was applied")
    if common.is_uint(samples) and common.is_uint(over) and int(samples) > 0:
        percent = int(over) * 100 // int(samples)
        if int(over) == 0:
            print(f"Above target: never, over {samples} samples")
        else:
            print(f"Above target: {percent}% of {samples} samples")


def print_status() -> None:
    if not STATE_FILE.is_file():
        try:
            STATE_FILE.stat()
        except OSError:
            print(f"No profile has been applied yet (no state file at {STATE_FILE}).")
            print("Apply one with: sudo elitebook-thermal-profile auto")
            return
    profile = current_value("profile")
    source = current_value("source")
    smu = current_value("smu")
    epp = current_value("epp")
    boost = current_value("boost")
    max_freq = current_value("max_freq")
    fast = current_value("fast_mw")
    slow = current_value("slow_mw")
    tctl = current_value("tctl_c")
    updated = current_value("updated")

    source_labels = {
        "manual": "set manually",
        "auto": "automatic (AC/battery)",
        "system-auto": "system automation",
        "steam-game-watcher": "Steam game detected",
        "guard-fallback": "update guard fallback",
        "": "unknown",
    }
    source_text = source_labels.get(source, source)

    if max_freq == "uncapped" or max_freq == "":
        freq_text = "uncapped"
    else:
        try:
            freq_text = f"{int(max_freq) // 1000} MHz"
        except ValueError:
            freq_text = max_freq

    print(f"Profile:      {profile or 'unknown'} ({source_text})")

    if smu == "ok":
        print("SMU limits:   applied")
    elif smu == "unavailable":
        print("SMU limits:   NOT applied - RyzenAdj is not installed")
    elif smu == "blocked":
        print("SMU limits:   NOT applied - blocked by kernel lockdown (Secure Boot)")
    elif smu == "failed":
        print("SMU limits:   NOT applied - RyzenAdj returned an error")
    else:
        print("SMU limits:   unknown (state written by an older version)")

    print(
        f"CPU policy:   EPP {epp or 'unknown'}, boost {boost or 'unknown'}, max frequency {freq_text}"
    )

    def watts(value: str) -> str:
        try:
            return str(int(value or "0") // 1000)
        except ValueError:
            return "0"

    if smu == "ok":
        print(
            f"Power limits: sustained {watts(slow)} W, burst {watts(fast)} W, thermal target {tctl or '?'} C"
        )
    elif smu == "":
        print(
            f"Power limits: recorded {watts(slow)} W sustained, {watts(fast)} W burst, {tctl or '?'} C target"
        )
    else:
        print(
            f"Power limits: requested {watts(slow)} W sustained / {watts(fast)} W burst / {tctl or '?'} C, NOT in force"
        )

    battery = battery_capacity()
    if battery:
        if on_ac_power():
            print(f"Battery:      {battery}% (on AC)")
        else:
            print(f"Battery:      {battery}% (on battery)")

    temp = cpu_temperature_c()
    if temp:
        print(f"CPU temp:     {temp} C")

    print_thermal_record()

    print(f"Updated:      {updated or 'unknown'}")

    if smu and smu != "ok":
        print("")
        print("This machine is running on CPU policy alone. See:")
        print(
            "  https://github.com/matteopasseri407/hp-elitebook-845-g8-ryzen-tuning/blob/main/docs/troubleshooting.md"
        )


