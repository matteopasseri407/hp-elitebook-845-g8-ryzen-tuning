def truthy(value: str | None) -> bool:
    return (value or "").strip().lower() in ("1", "true", "yes", "on")


# --- status ----------------------------------------------------------------


def read_state(path: Path) -> dict[str, str]:
    return common.read_key_value_file(path)


def on_ac_power() -> bool:
    return common.on_ac_power(POWER_SUPPLY_DIR)


def print_thermal_record(thermal: dict[str, str]) -> None:
    peak = thermal.get("peak_c", "")
    target = thermal.get("target_c", "")
    samples = thermal.get("samples", "")
    over = thermal.get("over_target", "")
    if not (common.is_uint(peak) and int(peak) > 0):
        return
    if common.is_uint(target) and int(target) > 0:
        print(
            f"Peak:         {peak} C since this profile was applied (target {target} C)"
        )
    else:
        print(f"Peak:         {peak} C since this profile was applied")
    if common.is_uint(samples) and common.is_uint(over) and int(samples) > 0:
        if int(over) == 0:
            print(f"Above target: never, over {samples} samples")
        else:
            percent = int(over) * 100 // int(samples)
            print(f"Above target: {percent}% of {samples} samples")


def print_status() -> None:
    if not STATE_FILE.exists():
        print(f"No profile has been applied yet (no state file at {STATE_FILE}).")
        print("Start the service with: sudo systemctl start elitebook-thermal-profile")
        return
    state = read_state(STATE_FILE)
    idle = read_state(IDLE_FILE)
    profile = state.get("profile", "")
    source = state.get("source", "")
    smu = state.get("smu", "")
    max_freq = state.get("max_freq", "")
    source_labels = {
        "manual": "set manually",
        "auto": "automatic (AC/battery)",
        "system-auto": "automatic (AC/battery)",
        "steam-game-watcher": "Steam game detected",
        "guard-fallback": "update guard fallback",
        "": "unknown",
    }
    if max_freq in ("uncapped", ""):
        freq_text = "uncapped"
    elif max_freq.isdecimal():
        freq_text = f"{int(max_freq) // 1000} MHz"
    else:
        freq_text = max_freq

    print(f"Profile:      {profile or 'unknown'} ({source_labels.get(source, source)})")
    smu_lines = {
        "ok": "applied",
        "unavailable": "NOT applied - RyzenAdj is not installed",
        "blocked": "NOT applied - blocked by kernel lockdown (Secure Boot)",
        "failed": "NOT applied - RyzenAdj returned an error",
    }
    print(f"SMU limits:   {smu_lines.get(smu, 'unknown')}")
    print(
        f"CPU policy:   EPP {state.get('epp') or 'unknown'}, boost "
        f"{state.get('boost') or 'unknown'}, max frequency {freq_text}"
    )

    def watts(key: str) -> str:
        value = state.get(key, "")
        return str(int(value) // 1000) if value.isdecimal() else "0"

    vrmmax = state.get("vrmmax_ma", "")
    vrm = f", VRM max {int(vrmmax) // 1000} A" if vrmmax.isdecimal() else ""
    tctl = state.get("tctl_c") or "?"
    if smu == "ok":
        print(
            f"Power limits: sustained {watts('slow_mw')} W, burst {watts('fast_mw')} W, "
            f"thermal target {tctl} C{vrm}"
        )
    else:
        print(
            f"Power limits: requested {watts('slow_mw')} W sustained / "
            f"{watts('fast_mw')} W burst / {tctl} C{vrm}, NOT in force"
        )

    runtime_pm = state.get("runtime_pm", "")
    panel = state.get("panel_power_savings", "")
    if runtime_pm or panel:
        devices = {"auto": "idle devices power down", "default": "kernel defaults"}
        if panel.isdecimal():
            panel_text = "off" if panel == "0" else f"level {panel}"
        else:
            panel_text = panel or "unknown"
        print(
            f"Devices:      {devices.get(runtime_pm, 'unknown')}, "
            f"panel power saving {panel_text}"
        )

    if idle.get("active") == "1":
        print(f"Idle:         {idle.get('stage', 'unknown')} overlay active")
    else:
        print("Idle:         off")

    battery = common.battery_capacity(POWER_SUPPLY_DIR)
    if battery is not None:
        where = "on AC" if on_ac_power() else "on battery"
        print(f"Battery:      {battery}% ({where})")
    temp = common.cpu_temperature_c(HWMON_DIR)
    if temp is not None:
        print(f"CPU temp:     {temp} C")
    print_thermal_record(read_state(THERMAL_FILE))
    print(f"Updated:      {state.get('updated') or 'unknown'}")

    if smu and smu != "ok":
        print("")
        print("This machine is running on CPU policy alone. See:")
        print(
            "  https://github.com/matteopasseri407/hp-elitebook-845-g8-ryzen-tuning"
            "/blob/main/docs/troubleshooting.md"
        )


