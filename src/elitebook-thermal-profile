        "epp": state.get("epp", "unknown") or "unknown",
        "boost": state.get("boost", "unknown") or "unknown",
        "max_freq": state.get("max_freq", "unknown") or "unknown",
        "power_mw": {
            "stapm": state.get("stapm_mw", "unknown") or "unknown",
            "fast": state.get("fast_mw", "unknown") or "unknown",
            "slow": state.get("slow_mw", "unknown") or "unknown",
            "apu": state.get("apu_mw", "unknown") or "unknown",
        },
        "tctl_c": state.get("tctl_c", "unknown") or "unknown",
        "battery_percent": battery_raw,
        "on_ac_power": on_ac_power(),
        "cpu_temp_c": temperature,
        "thermal": {
            "target_c": thermal.get("target_c"),
