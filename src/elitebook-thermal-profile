        f"CPU policy:   EPP {state.get('epp') or 'unknown'}, boost "
        f"{state.get('boost') or 'unknown'}, max frequency {freq_text}"
    )

    def watts(key: str) -> str:
        value = state.get(key, "")
        return str(int(value) // 1000) if value.isdecimal() else "0"

    vrmmax = state.get("vrmmax_ma", "")
    vrm = f", VRM max {int(vrmmax) // 1000} A" if vrmmax.isdecimal() else ""
    tctl = state.get("tctl_c") or "?"
