def find_ryzenadj() -> str | None:
    configured = os.environ.get("RYZENADJ", "")
    search_raw = os.environ.get(
        "ELITEBOOK_RYZENADJ_SEARCH_PATHS",
        "/usr/local/sbin/ryzenadj /usr/local/bin/ryzenadj /usr/bin/ryzenadj",
    )
    found = common.find_ryzenadj(configured, search_raw.split())
    if configured and found is None:
        die(f"RYZENADJ is set but is not executable: {configured}")
    return found


def kernel_lockdown_mode() -> str:
    return common.kernel_lockdown_mode(LOCKDOWN_PATH)


def detect_cpu_model() -> str:
    try:
        text = CPUINFO_PATH.read_text(encoding="utf-8", errors="ignore")
    except OSError:
        return ""
    for line in text.splitlines():
        if "model name" not in line:
            continue
        if ":" not in line:
            continue
        _, _, after = line.partition(":")
        return after.lstrip(" \t")
    return ""


def assert_supported_hardware() -> None:
    global DETECTED_PRODUCT, DETECTED_CPU
    if truthy(os.environ.get("ELITEBOOK_THERMAL_FORCE", "")):
        return
    vendor = common.read_trimmed(DMI_ID_DIR / "sys_vendor")
    product = common.read_trimmed(DMI_ID_DIR / "product_name")
    cpu = detect_cpu_model()
    DETECTED_PRODUCT = product
    DETECTED_CPU = cpu
    if vendor not in ("HP", "Hewlett-Packard"):
        die(
            f"unsupported vendor '{vendor}' (set ELITEBOOK_THERMAL_FORCE=1 to override)"
        )
    if not is_supported_product(product):
        die(
            f"unsupported product '{product}' (set ELITEBOOK_THERMAL_FORCE=1 to override)"
        )
    if CEZANNE_RE.search(cpu):
        return
    if REMBRANDT_RE.search(cpu):
        die(
            f"known HP AMD Rembrandt hardware '{product}' / '{cpu}' is not enabled yet "
            "because these SMU limits are only validated on Cezanne "
            "(set ELITEBOOK_THERMAL_FORCE=1 to override after reviewing profile values)"
        )
    die(
        f"unsupported CPU '{cpu}' (validated Cezanne CPUs: Ryzen PRO 5650U, 5750U, 5850U; "
        "set ELITEBOOK_THERMAL_FORCE=1 to override)"
    )


def detect_profile() -> str:
    if on_ac_power():
        return "ac"
    if battery_is_low():
        return "battery-saver"
    return "battery"


def profile_conf_value(key: str) -> tuple[str | None, int]:
    """Value and 1-based line number of the last matching key, if any."""
    try:
        text = PROFILE_CONF.read_text(encoding="utf-8", errors="ignore")
    except OSError:
        return None, 0
    pattern = re.compile(rf"^\s*{re.escape(key)}\s*=\s*(.*)$")
    last: str | None = None
    last_line = 0
    for lineno, line in enumerate(text.splitlines(), 1):
        match = pattern.match(line)
        if match:
            last = match.group(1)
            last_line = lineno
    if last is None:
        return None, 0
    last = last.split("#", 1)[0]
    last = re.sub(r"\s+", "", last)
    if not last:
        return None, 0
    return last, last_line


def override_uint(key: str, minimum: int, maximum: int, current: str) -> str:
    value, lineno = profile_conf_value(key)
    if value is None:
        return current
    if not common.is_uint(value):
        warn(
            f"{PROFILE_CONF} line {lineno}: {key}='{value}' is not an integer; "
            f"keeping {current}"
        )
        return current
    number = int(value)
    if number < minimum or number > maximum:
        warn(
            f"{PROFILE_CONF} line {lineno}: {key}={value} is outside the safe "
            f"range {minimum}-{maximum}; keeping {current}"
        )
        return current
    return value


def override_epp(key: str, current: str) -> str:
    value, lineno = profile_conf_value(key)
    if value is None:
        return current
    if value in VALID_EPPS:
        return value
    warn(
        f"{PROFILE_CONF} line {lineno}: {key}='{value}' is not a valid EPP "
        f"hint; keeping {current}"
    )
    return current


def acquire_dispatcher_lock() -> typing.TextIO:
    try:
        return common.acquire_dispatcher_lock(STATE_DIR, 10)
    except TimeoutError:
        die("could not acquire dispatcher lock within 10s")


def apply_tuned_profile(tuned_profile: str) -> None:
    if shutil.which("tuned-adm") is None:
        return
    current = ""
    try:
        current = (
            Path("/etc/tuned/active_profile")
            .read_text(encoding="utf-8", errors="ignore")
            .strip()
            .replace("\x00", "")
        )
    except OSError:
        current = ""
    if current == tuned_profile:
        return
    try:
        result = subprocess.run(
            ["tuned-adm", "profile", tuned_profile],
            stdout=subprocess.DEVNULL,
            stderr=subprocess.DEVNULL,
            timeout=10,
            check=False,
        )
        ok = result.returncode == 0
    except (OSError, subprocess.SubprocessError):
        ok = False
    if not ok:
        warn(
            f"tuned-adm did not apply '{tuned_profile}'; continuing with direct CPU/SMU policy."
        )


def apply_boost_and_freq(boost: str, max_freq: str) -> None:
    # Writes are skipped when the file already holds the desired value: udev
    # replays this dispatcher on every battery-percent event, and rewriting
    # identical sysfs values each time is pure churn.
    boost_value = "1" if boost == "on" else "0"
    boost_path = CPUFREQ_DIR / "boost"
    if boost_path.exists() and not common.sysfs_value_matches(boost_path, boost_value):
        try:
            boost_path.write_text(boost_value + "\n", encoding="utf-8")
        except OSError:
            warn("failed to write cpufreq boost")
    try:
        policies = sorted(CPUFREQ_DIR.glob("policy*"))
    except OSError:
        return
    for policy in policies:
        try:
            if not policy.is_dir():
                continue
        except OSError:
            continue
        scaling_max = policy / "scaling_max_freq"
        cpuinfo_max = policy / "cpuinfo_max_freq"
        if max_freq == "uncapped":
            try:
                writable = scaling_max.exists()
                readable = cpuinfo_max.is_file()
            except OSError:
                continue
            if writable and readable:
                try:
                    value = cpuinfo_max.read_text(encoding="utf-8")
                except OSError:
                    continue
                if common.sysfs_value_matches(scaling_max, value.strip()):
                    continue
                try:
                    scaling_max.write_text(value, encoding="utf-8")
                except OSError:
                    warn(f"failed to restore {policy}/scaling_max_freq")
        else:
            try:
                if not scaling_max.exists():
                    continue
            except OSError:
                continue
            if common.sysfs_value_matches(scaling_max, max_freq):
                continue
            try:
                scaling_max.write_text(max_freq + "\n", encoding="utf-8")
            except OSError:
                warn(f"rejected max freq {max_freq} for {policy}")


def apply_epp(epp: str) -> None:
    try:
        policies = sorted(CPUFREQ_DIR.glob("policy*"))
    except OSError:
        policies = []
    applied = 0
    for policy in policies:
        epp_path = policy / "energy_performance_preference"
        try:
            exists = epp_path.exists()
        except OSError:
            continue
        if not exists:
            continue
        if common.sysfs_value_matches(epp_path, epp):
            applied += 1
            continue
        try:
            epp_path.write_text(epp + "\n", encoding="utf-8")
            applied += 1
        except OSError:
            warn(f"failed to write EPP {epp} to {policy}")
    if applied == 0:
        warn(
            f"no cpufreq policy accepted EPP {epp}; skipping EPP (cpufreq driver not in EPP mode?)"
        )


def write_state(
    profile: str,
    profile_source: str,
    epp: str,
    smu_status: str,
    stapm: str,
    fast: str,
    slow: str,
    apu: str,
    tctl: str,
    boost: str,
    max_freq: str,
) -> None:
    battery_raw = common.battery_capacity(POWER_SUPPLY_DIR)
    battery_percent = str(battery_raw) if battery_raw is not None else "unknown"
    threshold = os.environ.get("ELITEBOOK_LOW_BATTERY_THRESHOLD", "20") or "20"
    updated = datetime.now().astimezone().isoformat(timespec="seconds")
    STATE_DIR.mkdir(mode=0o755, parents=True, exist_ok=True)
    tmp = STATE_DIR / f"current.tmp.{os.getpid()}"
    content = (
        f"profile={profile}\n"
        f"source={profile_source}\n"
        f"epp={epp}\n"
        f"smu={smu_status}\n"
        f"stapm_mw={stapm}\n"
        f"fast_mw={fast}\n"
        f"slow_mw={slow}\n"
        f"apu_mw={apu}\n"
        f"tctl_c={tctl}\n"
        f"boost={boost}\n"
        f"max_freq={max_freq}\n"
        f"battery_percent={battery_percent}\n"
        f"low_battery_threshold_percent={threshold}\n"
        f"updated={updated}\n"
    )
    tmp.write_text(content, encoding="utf-8")
    try:
        os.chmod(tmp, 0o644)
    except OSError:
        pass
    os.replace(tmp, STATE_FILE)


def reexec_via_sudo(argv: list[str]) -> typing.NoReturn:
    prog = argv[0] if argv else PROG
    if "/" in prog and not os.path.isabs(prog):
        prog = os.path.abspath(prog)
    # Through `env` rather than bare VAR= assignments so the preserved values
    # survive sudo's env_reset instead of being filtered before the dispatcher
    # even starts. Still interactive: no -n, a manual run may prompt.
    cmd = ["sudo", "env"]
    for key in SUDO_PRESERVE_ENV:
        cmd.append(f"{key}={os.environ.get(key, '')}")
    cmd.append(prog)
    cmd.extend(argv[1:])
    try:
        os.execvp("sudo", cmd)
    except OSError:
        die("sudo is required to apply a profile but was not found; re-run as root")
    raise SystemExit(1)  # pragma: no cover


def main(argv: list[str]) -> int:
    requested = argv[0] if argv else "auto"

    if requested in ("--help", "-h"):
        usage()
        return 0
    if requested == "--version":
        print(f"{PROG} {ELITEBOOK_VERSION}")
        return 0
    if requested == "status":
        if len(argv) > 1 and argv[1] == "--json":
            print_status_json()
        else:
            print_status()
        return 0

    assert_supported_hardware()

    if requested == "--check-hardware":
        if truthy(os.environ.get("ELITEBOOK_THERMAL_FORCE", "")):
            print("Hardware guard skipped: ELITEBOOK_THERMAL_FORCE is set.")
        else:
            print(
                f"Supported hardware detected: {DETECTED_PRODUCT or 'unknown product'} / "
                f"{DETECTED_CPU or 'unknown CPU'}."
            )
        return 0

    if os.geteuid() != 0:
        reexec_via_sudo(sys.argv)

    # An explicitly configured RYZENADJ that cannot be executed is fatal;
    # find_ryzenadj reports that itself.
    ryzenadj_bin = find_ryzenadj()

    lock_file = acquire_dispatcher_lock()
    try:
        profile_source = os.environ.get("ELITEBOOK_PROFILE_SOURCE", "")
        if not profile_source:
            profile_source = "auto" if requested == "auto" else "manual"

        current_source = current_value("source")
        auto_profile = ""
        if requested == "auto":
            auto_profile = detect_profile()

        if requested == "auto" and profile_source == "system-auto":
            if auto_profile != "battery-saver":
                if current_source == "manual":
                    print(
                        "Manual EliteBook thermal profile override is active; system auto left it unchanged."
                    )
                    return 0
                if current_source == "steam-game-watcher":
                    print(
                        "Steam game profile is active; system auto left it unchanged."
                    )
                    return 0

        if profile_source == "steam-game-watcher" and current_source == "manual":
            print(
                "Manual EliteBook thermal profile override is active; Steam watcher left it unchanged."
            )
            return 0

        profile = auto_profile if requested == "auto" else requested

        builtin = BUILTIN_PROFILES.get(profile)
        if builtin is None:
            usage()
            return 2
        (
            epp,
            stapm_i,
            fast_i,
            slow_i,
            apu_i,
            tctl_i,
            boost,
            max_freq_default,
            tuned_profile,
        ) = builtin
        stapm, fast, slow, apu, tctl = (
            str(stapm_i),
            str(fast_i),
            str(slow_i),
            str(apu_i),
            str(tctl_i),
        )
        if max_freq_default == "BATTERY_SAVER_ENV":
            max_freq = (
                os.environ.get("ELITEBOOK_BATTERY_SAVER_MAX_FREQ_KHZ", "1800000")
                or "1800000"
            )
            if not common.is_uint(max_freq):
                die("ELITEBOOK_BATTERY_SAVER_MAX_FREQ_KHZ must be an integer kHz value")
        elif max_freq_default is None:
            max_freq = "uncapped"
        else:
            max_freq = max_freq_default

        # Per-profile overrides: AC_SLOW_MW, COOL_TCTL_C, BATTERY_SAVER_EPP...
        prefix = profile.upper().replace("-", "_")
        stapm = override_uint(f"{prefix}_STAPM_MW", 4000, 45000, stapm)
        fast = override_uint(f"{prefix}_FAST_MW", 4000, 45000, fast)
        slow = override_uint(f"{prefix}_SLOW_MW", 4000, 45000, slow)
        apu = override_uint(f"{prefix}_APU_MW", 4000, 45000, apu)
        tctl = override_uint(f"{prefix}_TCTL_C", 60, 100, tctl)
        epp = override_epp(f"{prefix}_EPP", epp)

        apply_tuned_profile(tuned_profile)
        apply_boost_and_freq(boost, max_freq)
        apply_epp(epp)

        smu_status = "unavailable"
        if ryzenadj_bin:
            try:
                result = subprocess.run(
                    [
                        ryzenadj_bin,
                        f"--stapm-limit={stapm}",
                        f"--fast-limit={fast}",
                        f"--slow-limit={slow}",
                        f"--apu-slow-limit={apu}",
                        f"--tctl-temp={tctl}",
                    ],
                    stdout=subprocess.DEVNULL,
                    stderr=subprocess.DEVNULL,
                    check=False,
                )
                ok = result.returncode == 0
            except OSError:
                ok = False
            if ok:
                smu_status = "ok"
            else:
                lockdown = kernel_lockdown_mode()
                if lockdown != "none" and lockdown != "unavailable":
                    smu_status = "blocked"
                    warn(
                        f"RyzenAdj could not apply SMU limits; kernel lockdown is '{lockdown}', "
                        "which Secure Boot normally enables. CPU policy (EPP, boost, frequency) "
                        "was applied. See docs/troubleshooting.md."
                    )
                else:
                    smu_status = "failed"
                    warn(
                        "RyzenAdj failed to apply SMU limits. CPU policy (EPP, boost, frequency) was applied."
                    )
        else:
            warn(
                "RyzenAdj not found; applied CPU policy only (EPP, boost, frequency). "
                "Install ryzenadj for the SMU power limits, or set RYZENADJ=/path/to/ryzenadj."
            )

        write_state(
            profile,
            profile_source,
            epp,
            smu_status,
            stapm,
            fast,
            slow,
            apu,
            tctl,
            boost,
            max_freq,
        )

        print(
            f"EliteBook thermal profile '{profile}' applied: boost {boost}, max freq {max_freq}, "
            f"EPP {epp}, FAST {fast}mW, SLOW/APU {slow}mW, Tctl {tctl}C."
        )
        return 0
    finally:
        # Closing the lock file releases the flock; no explicit unlock dance.
        try:
            lock_file.close()
        except OSError:
            pass


if __name__ == "__main__":
    raise SystemExit(main(sys.argv[1:]))
