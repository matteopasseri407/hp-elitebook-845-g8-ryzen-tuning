# A wakeup more than this far ahead of the monotonic clock means the machine
# slept in between: CLOCK_BOOTTIME counts suspend, CLOCK_MONOTONIC does not.
RESUME_GAP_S = 2.0
CONFIG_CHECK_S = 5.0
# Power supply attributes are ACPI calls that can wake the embedded
# controller, so they are read when the kernel reports a change, plus this
# often as a safety net in case an event was lost.
try:
    POWER_POLL_S = float(os.environ.get("ELITEBOOK_POWER_POLL_INTERVAL", "60"))
except ValueError:
    POWER_POLL_S = 60.0
