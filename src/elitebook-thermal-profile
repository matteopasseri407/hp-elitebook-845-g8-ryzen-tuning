#!/usr/bin/env bash
# SPDX-License-Identifier: GPL-3.0-or-later
set -euo pipefail

# Keep in step with packaging/rpm/elitebook-thermal-profile.spec and
# packaging/debian/changelog; tests/test-version-consistency.sh enforces it.
ELITEBOOK_VERSION="0.6.0"

STATE_DIR="${ELITEBOOK_THERMAL_STATE_DIR:-/run/elitebook-thermal-profile}"
STATE_FILE="$STATE_DIR/current"
LOCK_FILE="$STATE_DIR/dispatcher.lock"
POWER_SUPPLY_DIR="${ELITEBOOK_POWER_SUPPLY_DIR:-/sys/class/power_supply}"
DMI_ID_DIR="${ELITEBOOK_DMI_ID_DIR:-/sys/class/dmi/id}"
CPUINFO_PATH="${ELITEBOOK_CPUINFO_PATH:-/proc/cpuinfo}"
CPUFREQ_DIR="${ELITEBOOK_CPUFREQ_DIR:-/sys/devices/system/cpu/cpufreq}"
LOCKDOWN_PATH="${ELITEBOOK_LOCKDOWN_PATH:-/sys/kernel/security/lockdown}"
PROFILE_CONF="${ELITEBOOK_PROFILE_CONF:-/etc/elitebook-thermal-profile/profiles.conf}"
HWMON_DIR="${ELITEBOOK_HWMON_DIR:-/sys/class/hwmon}"

DETECTED_PRODUCT=""
DETECTED_CPU=""

usage() {
  cat >&2 <<EOF
Usage: elitebook-thermal-profile [COMMAND]

Profiles (need root):
  auto              Pick by power source and battery level
  ac                Plugged in
  performance       Plugged in, more responsive
  battery           Unplugged
  battery-saver     Unplugged and low, or forced
  gaming            More sustained headroom
  cool              Quiet and cool

Commands:
  status            Show what is applied right now (no root needed)
  --check-hardware  Verify this machine is supported
  --version         Print the version
  -h, --help        Show this help

Configuration:
  $PROFILE_CONF
  Overrides individual profile values and survives package upgrades.
  See docs/configuration.md.

Environment:
  RYZENADJ=/path/to/ryzenadj
  ELITEBOOK_PROFILE_SOURCE=manual|auto|system-auto|steam-game-watcher
  ELITEBOOK_THERMAL_FORCE=1   skip the supported-hardware guard
  ELITEBOOK_LOW_BATTERY_THRESHOLD=20
  ELITEBOOK_BATTERY_SAVER_MAX_FREQ_KHZ=1800000
EOF
}

die() {
  echo "elitebook-thermal-profile: $*" >&2
  exit 1
}

read_trimmed() {
  local path="$1"
  [[ -r "$path" ]] || return 0
  tr -d '\0' <"$path" | sed 's/^[[:space:]]*//; s/[[:space:]]*$//'
}

truthy() {
  case "${1:-}" in
    1|true|TRUE|yes|YES|on|ON) return 0 ;;
    *) return 1 ;;
  esac
}

is_uint() {
  [[ "${1:-}" =~ ^[0-9]+$ ]]
}

is_supported_product() {
  case "$1" in
    *"EliteBook 835 G7"*|*"EliteBook 835 G8"*|*"EliteBook 835 G9"*|\
    *"EliteBook 845 G7"*|*"EliteBook 845 G8"*|*"EliteBook 845 G9"*|\
    *"ProBook 445 G8"*|*"ProBook 445 G9"*|\
    *"ProBook 455 G8"*|*"ProBook 455 G9"*)
      return 0
      ;;
    *)
      return 1
      ;;
  esac
}

is_validated_cezanne_cpu() {
  [[ "$1" =~ AMD\ Ryzen\ (5|7)\ PRO\ (5650U|5750U|5850U) ]]
}

is_known_rembrandt_cpu() {
  [[ "$1" =~ AMD\ Ryzen\ (5|7)\ PRO\ (6650U|6850U) ]]
}

on_ac_power() {
  if [[ -r "$POWER_SUPPLY_DIR/AC/online" ]]; then
    [[ "$(cat "$POWER_SUPPLY_DIR/AC/online")" = "1" ]]
    return
  fi

  local supply type online
  for supply in "$POWER_SUPPLY_DIR"/*; do
    [[ -r "$supply/type" ]] || continue
    type="$(read_trimmed "$supply/type")"
    [[ "$type" = "Mains" ]] || continue
    [[ -r "$supply/online" ]] || continue
    online="$(read_trimmed "$supply/online")"
    [[ "$online" = "1" ]]
    return
  done

  return 1
}

battery_device() {
  local supply type
  for supply in "$POWER_SUPPLY_DIR"/*; do
    [[ -r "$supply/type" ]] || continue
    type="$(read_trimmed "$supply/type")"
    if [[ "$type" = "Battery" ]]; then
      echo "$supply"
      return 0
    fi
  done
  return 1
}

battery_capacity() {
  local supply capacity
  supply="$(battery_device)" || return 1
  [[ -r "$supply/capacity" ]] || return 1
  capacity="$(read_trimmed "$supply/capacity")"
  is_uint "$capacity" || return 1
  echo "$capacity"
}

battery_is_low() {
  local threshold capacity
  threshold="${ELITEBOOK_LOW_BATTERY_THRESHOLD:-20}"
  is_uint "$threshold" || die "ELITEBOOK_LOW_BATTERY_THRESHOLD must be an integer percentage"
  [[ "$threshold" -gt 0 ]] || return 1
  on_ac_power && return 1
  capacity="$(battery_capacity)" || return 1
  [[ "$capacity" -le "$threshold" ]]
}

# CPU package temperature. k10temp is the in-tree driver; zenpower is a common
# out-of-tree replacement for it on Ryzen systems, and a machine running that
# one has no k10temp at all, so both are accepted.
cpu_temperature_c() {
  local wanted hwmon name temp

  for wanted in k10temp zenpower; do
    for hwmon in "$HWMON_DIR"/hwmon*; do
      [[ -r "$hwmon/name" ]] || continue
      name="$(read_trimmed "$hwmon/name")"
      [[ "$name" = "$wanted" ]] || continue
      [[ -r "$hwmon/temp1_input" ]] || continue
      temp="$(read_trimmed "$hwmon/temp1_input")"
      is_uint "$temp" || continue
      echo $((temp / 1000))
      return 0
    done
  done

  return 1
}

# Human-readable view of what the dispatcher last did. Deliberately runs
# without root: it only reads the state file and sysfs, and it is the first
# thing to reach for when the laptop is not behaving as expected.
print_status() {
  local profile source smu epp boost max_freq updated
  local stapm fast slow apu tctl battery temp freq_text

  if [[ ! -r "$STATE_FILE" ]]; then
    echo "No profile has been applied yet (no state file at $STATE_FILE)."
    echo "Apply one with: sudo elitebook-thermal-profile auto"
    return 0
  fi

  profile="$(current_value profile)"
  source="$(current_value source)"
  smu="$(current_value smu)"
  epp="$(current_value epp)"
  boost="$(current_value boost)"
  max_freq="$(current_value max_freq)"
  stapm="$(current_value stapm_mw)"
  fast="$(current_value fast_mw)"
  slow="$(current_value slow_mw)"
  apu="$(current_value apu_mw)"
  tctl="$(current_value tctl_c)"
  updated="$(current_value updated)"

  case "$source" in
    manual) source="set manually" ;;
    auto) source="automatic (AC/battery)" ;;
    system-auto) source="system automation" ;;
    steam-game-watcher) source="Steam game detected" ;;
    guard-fallback) source="update guard fallback" ;;
    "") source="unknown" ;;
  esac

  if [[ "$max_freq" = "uncapped" || -z "$max_freq" ]]; then
    freq_text="uncapped"
  else
    freq_text="$((max_freq / 1000)) MHz"
  fi

  printf 'Profile:      %s (%s)\n' "${profile:-unknown}" "$source"

  case "$smu" in
    ok)
      printf 'SMU limits:   applied\n'
      ;;
    unavailable)
      printf 'SMU limits:   NOT applied - RyzenAdj is not installed\n'
      ;;
    blocked)
      printf 'SMU limits:   NOT applied - blocked by kernel lockdown (Secure Boot)\n'
      ;;
    failed)
      printf 'SMU limits:   NOT applied - RyzenAdj returned an error\n'
      ;;
    *)
      printf 'SMU limits:   unknown (state written by an older version)\n'
      ;;
  esac

  printf 'CPU policy:   EPP %s, boost %s, max frequency %s\n' \
    "${epp:-unknown}" "${boost:-unknown}" "$freq_text"

  case "$smu" in
    ok)
      printf 'Power limits: sustained %s W, burst %s W, thermal target %s C\n' \
        "$((${slow:-0} / 1000))" "$((${fast:-0} / 1000))" "${tctl:-?}"
      ;;
    "")
      # State from a version that predates SMU reporting. Do not claim the
      # limits failed: on such a machine they were almost certainly applied.
      printf 'Power limits: recorded %s W sustained, %s W burst, %s C target\n' \
        "$((${slow:-0} / 1000))" "$((${fast:-0} / 1000))" "${tctl:-?}"
      ;;
    *)
      printf 'Power limits: requested %s W sustained / %s W burst / %s C, NOT in force\n' \
        "$((${slow:-0} / 1000))" "$((${fast:-0} / 1000))" "${tctl:-?}"
      ;;
  esac

  battery="$(battery_capacity || true)"
  if [[ -n "$battery" ]]; then
    if on_ac_power; then
      printf 'Battery:      %s%% (on AC)\n' "$battery"
    else
      printf 'Battery:      %s%% (on battery)\n' "$battery"
    fi
  fi

  temp="$(cpu_temperature_c || true)"
  [[ -n "$temp" ]] && printf 'CPU temp:     %s C\n' "$temp"

  printf 'Updated:      %s\n' "${updated:-unknown}"

  if [[ -n "$smu" && "$smu" != "ok" ]]; then
    printf '\nThis machine is running on CPU policy alone. See:\n'
    printf '  https://github.com/matteopasseri407/hp-elitebook-845-g8-ryzen-tuning/blob/main/docs/troubleshooting.md\n'
  fi
}

find_ryzenadj() {
  local candidate

  if [[ -n "${RYZENADJ:-}" ]]; then
    [[ -x "$RYZENADJ" ]] || die "RYZENADJ is set but is not executable: $RYZENADJ"
    echo "$RYZENADJ"
    return 0
  fi

  # Overridable so the degraded path can be exercised on a machine that does
  # have RyzenAdj installed.
  # shellcheck disable=SC2206
  local search=(${ELITEBOOK_RYZENADJ_SEARCH_PATHS:-/usr/local/sbin/ryzenadj /usr/local/bin/ryzenadj /usr/bin/ryzenadj})

  for candidate in "${search[@]}"; do
    if [[ -x "$candidate" ]]; then
      echo "$candidate"
      return 0
    fi
  done

  if command -v ryzenadj >/dev/null 2>&1; then
    command -v ryzenadj
    return 0
  fi

  # Not finding RyzenAdj is not fatal. The SMU limits are the reason this
  # project exists, but EPP, boost, and the frequency cap are applied through
  # sysfs and work on their own, so apply what is available and say what is
  # missing instead of refusing to run at all.
  return 1
}

# Reports the active kernel lockdown mode: none, integrity, confidentiality,
# or unavailable when the kernel does not expose it. Secure Boot normally
# turns lockdown on, and lockdown is what blocks RyzenAdj's /dev/mem access.
kernel_lockdown_mode() {
  local content

  [[ -r "$LOCKDOWN_PATH" ]] || { echo unavailable; return; }

  content="$(tr -d '\0\n' <"$LOCKDOWN_PATH")"
  if [[ "$content" == *"[none]"* ]]; then
    echo none
  elif [[ "$content" =~ \[([^]]+)\] ]]; then
    echo "${BASH_REMATCH[1]}"
  else
    echo "${content:-unknown}"
  fi
}

assert_supported_hardware() {
  truthy "${ELITEBOOK_THERMAL_FORCE:-}" && return 0

  local vendor product cpu
  vendor="$(read_trimmed "$DMI_ID_DIR/sys_vendor")"
  # Recorded for the --check-hardware message, which used to name the
  # development machine no matter what it was actually running on.
  DETECTED_PRODUCT=""
  DETECTED_CPU=""
  product="$(read_trimmed "$DMI_ID_DIR/product_name")"
  cpu="$(awk -F: '/model name/ {sub(/^[ \t]+/, "", $2); print $2; exit}' "$CPUINFO_PATH" 2>/dev/null || true)"
  DETECTED_PRODUCT="$product"
  DETECTED_CPU="$cpu"

  [[ "$vendor" == "HP" || "$vendor" == "Hewlett-Packard" ]] ||
    die "unsupported vendor '$vendor' (set ELITEBOOK_THERMAL_FORCE=1 to override)"

  is_supported_product "$product" ||
    die "unsupported product '$product' (set ELITEBOOK_THERMAL_FORCE=1 to override)"

  if is_validated_cezanne_cpu "$cpu"; then
    return 0
  fi

  if is_known_rembrandt_cpu "$cpu"; then
    die "known HP AMD Rembrandt hardware '$product' / '$cpu' is not enabled yet because these SMU limits are only validated on Cezanne (set ELITEBOOK_THERMAL_FORCE=1 to override after reviewing profile values)"
  fi

  die "unsupported CPU '$cpu' (validated Cezanne CPUs: Ryzen PRO 5650U, 5750U, 5850U; set ELITEBOOK_THERMAL_FORCE=1 to override)"
}

detect_profile() {
  if on_ac_power; then
    echo ac
  elif battery_is_low; then
    echo battery-saver
  else
    echo battery
  fi
}

current_value() {
  local key="$1"
  awk -F= -v key="$key" '$1 == key {print $2; exit}' "$STATE_FILE" 2>/dev/null || true
}

# Reads one key from the profile configuration file. The file is parsed, never
# sourced: a stray line in it must not be able to run commands as root.
profile_conf_value() {
  local key="$1" value

  [[ -r "$PROFILE_CONF" ]] || return 1

  value="$(sed -n "s/^[[:space:]]*${key}[[:space:]]*=[[:space:]]*//p" "$PROFILE_CONF" | tail -n 1)"
  value="${value%%#*}"
  value="${value//[[:space:]]/}"
  [[ -n "$value" ]] || return 1

  printf '%s' "$value"
}

# Power limits are exactly the numbers that cook a laptop when copied from a
# desktop guide, so overrides are clamped to a range the tested chassis can
# survive. A rejected value keeps the built-in default: a typo in this file
# must never leave the machine running untuned.
override_uint() {
  local key="$1" min="$2" max="$3" current="$4" value

  value="$(profile_conf_value "$key")" || { printf '%s' "$current"; return; }

  if ! is_uint "$value"; then
    echo "elitebook-thermal-profile: warning: $PROFILE_CONF: $key='$value' is not an integer; keeping $current" >&2
    printf '%s' "$current"
    return
  fi

  if ((value < min || value > max)); then
    echo "elitebook-thermal-profile: warning: $PROFILE_CONF: $key=$value is outside the safe range ${min}-${max}; keeping $current" >&2
    printf '%s' "$current"
    return
  fi

  printf '%s' "$value"
}

override_epp() {
  local key="$1" current="$2" value

  value="$(profile_conf_value "$key")" || { printf '%s' "$current"; return; }

  case "$value" in
    performance|balance_performance|balance_power|power)
      printf '%s' "$value"
      ;;
    *)
      echo "elitebook-thermal-profile: warning: $PROFILE_CONF: $key='$value' is not a valid EPP hint; keeping $current" >&2
      printf '%s' "$current"
      ;;
  esac
}

# Per-profile overrides, keyed by profile name: AC_SLOW_MW, COOL_TCTL_C,
# BATTERY_SAVER_EPP and so on. Anything absent keeps the built-in value, so a
# user only writes down what they want to change.
apply_profile_overrides() {
  local prefix

  [[ -r "$PROFILE_CONF" ]] || return 0

  prefix="$(printf '%s' "$1" | tr '[:lower:]' '[:upper:]' | tr '-' '_')"

  stapm="$(override_uint "${prefix}_STAPM_MW" 4000 45000 "$stapm")"
  fast="$(override_uint "${prefix}_FAST_MW" 4000 45000 "$fast")"
  slow="$(override_uint "${prefix}_SLOW_MW" 4000 45000 "$slow")"
  apu="$(override_uint "${prefix}_APU_MW" 4000 45000 "$apu")"
  tctl="$(override_uint "${prefix}_TCTL_C" 60 100 "$tctl")"
  epp="$(override_epp "${prefix}_EPP" "$epp")"
}

write_state() {
  local battery_percent tmp
  battery_percent="$(battery_capacity || true)"
  [[ -n "$battery_percent" ]] || battery_percent="unknown"

  "${SUDO[@]}" install -d -m 0755 "$STATE_DIR"
  tmp="$STATE_FILE.tmp.$$"
  # smu records whether the RyzenAdj limits below actually took effect:
  #   ok          applied
  #   unavailable RyzenAdj is not installed
  #   blocked     kernel lockdown refused the write (usually Secure Boot)
  #   failed      RyzenAdj ran and returned an error
  # When it is not ok, the stapm/fast/slow/apu/tctl values are what was
  # requested, not what the hardware is running.
  printf 'profile=%s\nsource=%s\nepp=%s\nsmu=%s\nstapm_mw=%s\nfast_mw=%s\nslow_mw=%s\napu_mw=%s\ntctl_c=%s\nboost=%s\nmax_freq=%s\nbattery_percent=%s\nlow_battery_threshold_percent=%s\nupdated=%s\n' \
    "$profile" "$profile_source" "$epp" "${smu_status:-unknown}" "$stapm" "$fast" "$slow" "$apu" "$tctl" "$boost" "$max_freq" "$battery_percent" "${ELITEBOOK_LOW_BATTERY_THRESHOLD:-20}" "$(date --iso-8601=seconds)" |
    "${SUDO[@]}" tee "$tmp" >/dev/null
  "${SUDO[@]}" chmod 0644 "$tmp"
  "${SUDO[@]}" mv -f "$tmp" "$STATE_FILE"
}

requested_profile="${1:-auto}"

# These answer questions about the machine rather than changing it, so they
# run before the hardware guard and without root.
case "$requested_profile" in
  --help|-h)
    usage
    exit 0
    ;;
  --version)
    echo "elitebook-thermal-profile $ELITEBOOK_VERSION"
    exit 0
    ;;
  status)
    print_status
    exit 0
    ;;
esac

assert_supported_hardware

if [[ "$requested_profile" = "--check-hardware" ]]; then
  if truthy "${ELITEBOOK_THERMAL_FORCE:-}"; then
    echo "Hardware guard skipped: ELITEBOOK_THERMAL_FORCE is set."
  else
    echo "Supported hardware detected: ${DETECTED_PRODUCT:-unknown product} / ${DETECTED_CPU:-unknown CPU}."
  fi
  exit 0
fi

if [[ "${EUID}" -ne 0 ]]; then
  exec sudo \
    RYZENADJ="${RYZENADJ:-}" \
    ELITEBOOK_PROFILE_SOURCE="${ELITEBOOK_PROFILE_SOURCE:-}" \
    ELITEBOOK_THERMAL_FORCE="${ELITEBOOK_THERMAL_FORCE:-}" \
    ELITEBOOK_LOW_BATTERY_THRESHOLD="${ELITEBOOK_LOW_BATTERY_THRESHOLD:-}" \
    ELITEBOOK_BATTERY_SAVER_MAX_FREQ_KHZ="${ELITEBOOK_BATTERY_SAVER_MAX_FREQ_KHZ:-}" \
    ELITEBOOK_THERMAL_STATE_DIR="${ELITEBOOK_THERMAL_STATE_DIR:-}" \
    ELITEBOOK_POWER_SUPPLY_DIR="${ELITEBOOK_POWER_SUPPLY_DIR:-}" \
    ELITEBOOK_DMI_ID_DIR="${ELITEBOOK_DMI_ID_DIR:-}" \
    ELITEBOOK_CPUINFO_PATH="${ELITEBOOK_CPUINFO_PATH:-}" \
    ELITEBOOK_CPUFREQ_DIR="${ELITEBOOK_CPUFREQ_DIR:-}" \
    ELITEBOOK_LOCKDOWN_PATH="${ELITEBOOK_LOCKDOWN_PATH:-}" \
    ELITEBOOK_RYZENADJ_SEARCH_PATHS="${ELITEBOOK_RYZENADJ_SEARCH_PATHS:-}" \
    ELITEBOOK_PROFILE_CONF="${ELITEBOOK_PROFILE_CONF:-}" \
    ELITEBOOK_HWMON_DIR="${ELITEBOOK_HWMON_DIR:-}" \
    "$0" "$@"
fi

SUDO=()

acquire_dispatcher_lock() {
  install -d -m 0755 "$STATE_DIR"
  exec 9>"$LOCK_FILE"
  flock -w 10 -x 9 || die "could not acquire dispatcher lock within 10s"
}

# An explicitly configured RYZENADJ that cannot be executed is a configuration
# error and stays fatal. Not having RyzenAdj at all is not: the dispatcher
# degrades to the sysfs controls below and records that it did.
if [[ -n "${RYZENADJ:-}" && ! -x "${RYZENADJ}" ]]; then
  die "RYZENADJ is set but is not executable: $RYZENADJ"
fi
RYZENADJ_BIN="$(find_ryzenadj || true)"
acquire_dispatcher_lock

profile_source="${ELITEBOOK_PROFILE_SOURCE:-}"
if [[ -z "$profile_source" ]]; then
  if [[ "$requested_profile" = "auto" ]]; then
    profile_source="auto"
  else
    profile_source="manual"
  fi
fi

current_source="$(current_value source)"
auto_profile=""
if [[ "$requested_profile" = "auto" ]]; then
  auto_profile="$(detect_profile)"
fi

if [[ "$requested_profile" = "auto" && "$profile_source" = "system-auto" ]]; then
  if [[ "$auto_profile" != "battery-saver" ]]; then
    case "$current_source" in
      manual)
        echo "Manual EliteBook thermal profile override is active; system auto left it unchanged."
        exit 0
        ;;
      steam-game-watcher)
        echo "Steam game profile is active; system auto left it unchanged."
        exit 0
        ;;
    esac
  fi
fi

if [[ "$profile_source" = "steam-game-watcher" && "$current_source" = "manual" ]]; then
  echo "Manual EliteBook thermal profile override is active; Steam watcher left it unchanged."
  exit 0
fi

profile="$requested_profile"
if [[ "$profile" = "auto" ]]; then
  profile="$auto_profile"
fi

boost=on
max_freq=uncapped
tuned_profile=balanced

# The stapm values below only take effect on units running with STT disabled.
# On STT platforms (the 845 G8 included) the firmware rewrites the STAPM limit
# with the fast limit within about a second of the write, so the sustained
# envelope is governed by the slow limit. See docs/troubleshooting.md.
case "$profile" in
  ac)
    epp="balance_power"
    stapm=22000
    fast=30000
    slow=18000
    apu=18000
    tctl=90
    ;;
  performance)
    epp="balance_performance"
    stapm=22000
    fast=30000
    slow=18000
    apu=18000
    tctl=90
    ;;
  battery)
    epp="balance_power"
    stapm=18000
    fast=30000
    slow=15000
    apu=15000
    tctl=88
    ;;
  battery-saver)
    epp="power"
    stapm=10000
    fast=15000
    slow=8000
    apu=8000
    tctl=80
    boost=off
    max_freq="${ELITEBOOK_BATTERY_SAVER_MAX_FREQ_KHZ:-1800000}"
    tuned_profile=powersave
    is_uint "$max_freq" || die "ELITEBOOK_BATTERY_SAVER_MAX_FREQ_KHZ must be an integer kHz value"
    ;;
  gaming)
    epp="balance_performance"
    stapm=30000
    fast=30000
    slow=23000
    apu=23000
    tctl=92
    ;;
  cool)
    epp="power"
    stapm=16000
    fast=22000
    slow=12000
    apu=12000
    tctl=85
    ;;
  *)
    usage
    exit 2
    ;;
esac

apply_profile_overrides "$profile"

if command -v tuned-adm >/dev/null 2>&1; then
  current_tuned_profile=""
  if [[ -r /etc/tuned/active_profile ]]; then
    current_tuned_profile="$(read_trimmed /etc/tuned/active_profile)"
  fi

  if [[ "$current_tuned_profile" != "$tuned_profile" ]]; then
    if ! "${SUDO[@]}" timeout 10s tuned-adm profile "$tuned_profile" >/dev/null; then
      echo "elitebook-thermal-profile: warning: tuned-adm did not apply '$tuned_profile'; continuing with direct CPU/SMU policy." >&2
    fi
  fi
fi

# The inner script receives values as positional parameters; keep it single
# quoted so the outer shell does not expand sysfs paths or loop variables.
# A failed or unsupported sysfs write must not abort the dispatcher under
# set -e before the SMU limits are applied, so the inner script warns and
# always exits 0.
# shellcheck disable=SC2016
"${SUDO[@]}" sh -c '
cpufreq_dir="$1"
boost_value="$2"
max_freq="$3"

if [ -w "$cpufreq_dir/boost" ]; then
  echo "$boost_value" > "$cpufreq_dir/boost" 2>/dev/null ||
    echo "elitebook-thermal-profile: warning: failed to write cpufreq boost" >&2
fi

for d in "$cpufreq_dir"/policy*; do
  [ -d "$d" ] || continue
  if [ "$max_freq" = "uncapped" ] && [ -w "$d/scaling_max_freq" ] && [ -r "$d/cpuinfo_max_freq" ]; then
    cat "$d/cpuinfo_max_freq" > "$d/scaling_max_freq" 2>/dev/null ||
      echo "elitebook-thermal-profile: warning: failed to restore $d/scaling_max_freq" >&2
  elif [ "$max_freq" != "uncapped" ] && [ -w "$d/scaling_max_freq" ]; then
    echo "$max_freq" > "$d/scaling_max_freq" 2>/dev/null ||
      echo "elitebook-thermal-profile: warning: rejected max freq $max_freq for $d" >&2
  fi
done
exit 0
' sh "$CPUFREQ_DIR" "$([[ "$boost" = "on" ]] && echo 1 || echo 0)" "$max_freq"

# EPP files only exist when the cpufreq driver runs in EPP mode (for example
# amd-pstate-epp). On passive/guided drivers no policy is writable; warn and
# continue so RyzenAdj limits and the state file are still applied.
# shellcheck disable=SC2016
"${SUDO[@]}" sh -c '
cpufreq_dir="$1"
epp="$2"
applied=0
for d in "$cpufreq_dir"/policy*; do
  [ -w "$d/energy_performance_preference" ] || continue
  if echo "$epp" > "$d/energy_performance_preference" 2>/dev/null; then
    applied=$((applied + 1))
  else
    echo "elitebook-thermal-profile: warning: failed to write EPP $epp to $d" >&2
  fi
done
if [ "$applied" -eq 0 ]; then
  echo "elitebook-thermal-profile: warning: no cpufreq policy accepted EPP $epp; skipping EPP (cpufreq driver not in EPP mode?)" >&2
fi
exit 0
' sh "$CPUFREQ_DIR" "$epp"

# SMU limits are the part that needs RyzenAdj, and the part Secure Boot can
# block. Everything above already applied. Record what happened instead of
# aborting, so the state file and the panel indicator stay truthful and a
# degraded run is visible rather than silent.
smu_status=unavailable
if [[ -n "$RYZENADJ_BIN" ]]; then
  if "${SUDO[@]}" "$RYZENADJ_BIN" \
    --stapm-limit="$stapm" \
    --fast-limit="$fast" \
    --slow-limit="$slow" \
    --apu-slow-limit="$apu" \
    --tctl-temp="$tctl"; then
    smu_status=ok
  else
    lockdown="$(kernel_lockdown_mode)"
    if [[ "$lockdown" != "none" && "$lockdown" != "unavailable" ]]; then
      smu_status=blocked
      echo "elitebook-thermal-profile: warning: RyzenAdj could not apply SMU limits; kernel lockdown is '$lockdown', which Secure Boot normally enables. CPU policy (EPP, boost, frequency) was applied. See docs/troubleshooting.md." >&2
    else
      smu_status=failed
      echo "elitebook-thermal-profile: warning: RyzenAdj failed to apply SMU limits. CPU policy (EPP, boost, frequency) was applied." >&2
    fi
  fi
else
  echo "elitebook-thermal-profile: warning: RyzenAdj not found; applied CPU policy only (EPP, boost, frequency). Install ryzenadj for the SMU power limits, or set RYZENADJ=/path/to/ryzenadj." >&2
fi

write_state

echo "EliteBook thermal profile '$profile' applied: boost $boost, max freq $max_freq, EPP $epp, FAST ${fast}mW, SLOW/APU ${slow}mW, Tctl ${tctl}C."
