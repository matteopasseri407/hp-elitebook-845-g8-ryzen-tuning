# --- hardware and settings -------------------------------------------------


def detect_cpu_model() -> str:
    try:
        text = CPUINFO_PATH.read_text(encoding="utf-8", errors="ignore")
    except OSError:
        return ""
    for line in text.splitlines():
        if "model name" in line and ":" in line:
            return line.partition(":")[2].lstrip(" \t")
    return ""


def check_hardware() -> str:
    """A description of the supported machine; exits when unsupported."""
    product = common.read_trimmed(DMI_ID_DIR / "product_name")
    cpu = detect_cpu_model()
    if truthy(os.environ.get("ELITEBOOK_THERMAL_FORCE")):
        return "forced"
    vendor = common.read_trimmed(DMI_ID_DIR / "sys_vendor")
    problem = profiles.hardware_problem(vendor, product, cpu)
    if problem:
        die(problem)
    return f"{product or 'unknown product'} / {cpu or 'unknown CPU'}"


def find_ryzenadj() -> str | None:
    configured = os.environ.get("RYZENADJ", "")
    search = os.environ.get(
        "ELITEBOOK_RYZENADJ_SEARCH_PATHS",
        "/usr/local/sbin/ryzenadj /usr/local/bin/ryzenadj /usr/bin/ryzenadj",
    )
    found = common.find_ryzenadj(configured, search.split())
    if configured and found is None:
        die(f"RYZENADJ is set but is not executable: {configured}")
    return found


def low_battery_threshold() -> int:
    raw = os.environ.get("ELITEBOOK_LOW_BATTERY_THRESHOLD", "20").strip()
    if not raw.isdecimal():
        die("ELITEBOOK_LOW_BATTERY_THRESHOLD must be an integer percentage")
    return int(raw)


def battery_saver_max_freq() -> int:
    raw = os.environ.get("ELITEBOOK_BATTERY_SAVER_MAX_FREQ_KHZ", "").strip()
    if not raw:
        return profiles.BATTERY_SAVER_MAX_FREQ_KHZ
    if not raw.isdecimal():
        die("ELITEBOOK_BATTERY_SAVER_MAX_FREQ_KHZ must be an integer kHz value")
    return int(raw)


def config_mtime() -> float | None:
    try:
        return PROFILE_CONF.stat().st_mtime
    except OSError:
        return None


def stock_vrmmax(ryzenadj: str | None, log: engine_mod.Log) -> int | None:
    """The firmware's EDC limit, recorded once per boot before the first write.

    Recorded only when no profile has been applied since boot (no state file
    yet): reading it later would capture a limit some profile set, not the
    firmware's. The record lives in /run, so every boot measures again.
    """
    record = STATE_DIR / "smu-stock"
    saved = common.read_key_value_file(record).get("vrmmax_ma", "")
    if saved.isdecimal():
        return int(saved)
    if ryzenadj is None or STATE_FILE.exists():
        return None
    value = engine_mod.read_stock_vrmmax_ma(ryzenadj)
    if value is None:
        return None
    try:
        common.write_atomic(record, f"vrmmax_ma={value}\n")
    except OSError:
        pass
    log.info(f"Firmware VRM peak current limit recorded: {value // 1000} A.")
    return value


def build_engine(
    log: engine_mod.Log,
    idle: profiles.IdleSettings,
    manual: str | None,
) -> engine_mod.Engine:
    ryzenadj = find_ryzenadj()
    hardware = engine_mod.SysfsHardware(
        cpufreq_dir=CPUFREQ_DIR,
        pci_devices_dir=PCI_DEVICES_DIR,
        drm_dir=DRM_DIR,
        runtime_pm_defaults=STATE_DIR / "runtime-pm-defaults",
        lockdown_path=LOCKDOWN_PATH,
        ryzenadj=ryzenadj,
        stock_vrmmax_ma=stock_vrmmax(ryzenadj, log),
    )
    STATE_DIR.mkdir(mode=0o755, parents=True, exist_ok=True)
    return engine_mod.Engine(
        hardware,
        engine_mod.StateFiles(STATE_DIR, log),
        log,
        profiles.ProfileConfig.load(PROFILE_CONF),
        idle,
        low_battery_threshold(),
        battery_saver_max_freq(),
        manual,
    )


# --- control socket --------------------------------------------------------


def daemon_reachable() -> bool:
    try:
        with socket.socket(socket.AF_UNIX, socket.SOCK_STREAM) as sock:
            sock.settimeout(1)
            sock.connect(str(CONTROL_SOCKET))
            return True
    except OSError:
        return False


def send_request(request: dict[str, str]) -> dict[str, typing.Any]:
    try:
        with socket.socket(socket.AF_UNIX, socket.SOCK_STREAM) as sock:
            sock.settimeout(30)
            sock.connect(str(CONTROL_SOCKET))
            sock.sendall(json.dumps(request).encode() + b"\n")
            data = b""
            while not data.endswith(b"\n"):
                chunk = sock.recv(4096)
                if not chunk:
                    break
                data += chunk
    except (FileNotFoundError, ConnectionRefusedError):
        die(SERVICE_DOWN)
    except OSError as exc:
        die(f"could not talk to the service: {exc}")
    try:
        reply = json.loads(data.decode())
    except ValueError:
        die("the service sent an unreadable reply")
    if not isinstance(reply, dict):
        die("the service sent an unreadable reply")
    return typing.cast(dict[str, typing.Any], reply)


def peer_uid(conn: socket.socket) -> int:
    creds = conn.getsockopt(
        socket.SOL_SOCKET, socket.SO_PEERCRED, struct.calcsize("3i")
    )
    return int(struct.unpack("3i", creds)[1])


def sd_notify(message: str) -> None:
    address = os.environ.get("NOTIFY_SOCKET")
    if not address:
        return
    if address.startswith("@"):
        address = "\0" + address[1:]
    try:
        with socket.socket(socket.AF_UNIX, socket.SOCK_DGRAM) as sock:
            sock.sendto(message.encode(), address)
    except OSError:
        pass


class PowerWatch:
    """AC and battery state, reread when the kernel reports a power change."""

    def __init__(self, log: engine_mod.Log) -> None:
        self.sock: socket.socket | None = None
        try:
            sock = socket.socket(
                socket.AF_NETLINK, socket.SOCK_DGRAM, NETLINK_KOBJECT_UEVENT
            )
            sock.bind((0, 1))
            sock.setblocking(False)
            self.sock = sock
        except OSError as exc:
            log.warn(
                f"kernel power events are unavailable ({exc}); reading the power "
                "supply every tick instead"
            )
        self.dirty = True
        self.next_poll = 0.0
        self.on_ac = False
        self.battery: int | None = None

    def drain(self) -> None:
        if self.sock is None:
            return
        while True:
            try:
                message = self.sock.recv(65536)
            except BlockingIOError:
                return
            except OSError:
                # ENOBUFS: events were dropped, so assume one was ours.
                self.dirty = True
                return
            if b"SUBSYSTEM=power_supply" in message.split(b"\0"):
                self.dirty = True

    def read(self, now: float) -> tuple[bool, int | None]:
        if self.sock is None or self.dirty or now >= self.next_poll:
            self.on_ac = common.on_ac_power(POWER_SUPPLY_DIR)
            self.battery = common.battery_capacity(POWER_SUPPLY_DIR)
            self.dirty = False
            self.next_poll = now + POWER_POLL_S
        return self.on_ac, self.battery

    def close(self) -> None:
        if self.sock is not None:
            self.sock.close()


class Daemon:
    def __init__(self) -> None:
        self.log = engine_mod.Log(PROG)
        # Before touching any state file: a second daemon must not disturb
        # the one already running.
        if daemon_reachable():
            die("another elitebook-thermal-profile daemon is already running")
        check_hardware()
        idle = profiles.IdleSettings.from_env()
        state_files = engine_mod.StateFiles(STATE_DIR, self.log)
        # A fresh daemon starts outside any idle overlay; an overlay file left
        # by a crash or by the old watcher would make the panel show one.
        state_files.clear_idle()
        self.engine = build_engine(self.log, idle, state_files.read_override())
        hardware = self.engine.hardware
        if isinstance(hardware, engine_mod.SysfsHardware):
            if hardware.disable_dynamic_epp():
                self.log.info(
                    "Turned off amd-pstate dynamic EPP: this service sets EPP itself."
                )
        self.games = engine_mod.GameDetector(
            enabled=truthy(os.environ.get("ELITEBOOK_STEAM_DETECTION", "1")),
            interval_ac=float(
                engine_mod.env_int("ELITEBOOK_STEAM_WATCH_INTERVAL_AC", 30)
            ),
            interval_battery=float(
                engine_mod.env_int("ELITEBOOK_STEAM_WATCH_INTERVAL_BATTERY", 120)
            ),
            interval_active=float(
                engine_mod.env_int("ELITEBOOK_STEAM_WATCH_INTERVAL_ACTIVE", 20)
            ),
        )
        self.game: dict[str, str] | None = None
        self.sampler = engine_mod.CpuSampler()
        self.power = PowerWatch(self.log)
        self.temp_input = common.find_temperature_input(HWMON_DIR)
        self.next_sensor_search = 0.0
        try:
            self.tick_s = max(
                0.2, float(os.environ.get("ELITEBOOK_IDLE_SAMPLE_INTERVAL", "1"))
            )
        except ValueError:
            self.tick_s = 1.0
        self.config_mtime = config_mtime()
        self.next_config_check = 0.0
        self.stopping = False
        self.listener = self._listen()
        self.last_boot = time.clock_gettime(time.CLOCK_BOOTTIME)
        self.last_mono = time.monotonic()

    def _listen(self) -> socket.socket:
        if daemon_reachable():
            die("another elitebook-thermal-profile daemon is already running")
        try:
            CONTROL_SOCKET.unlink()
        except FileNotFoundError:
            pass
        listener = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
        old_umask = os.umask(0o177)
        try:
            listener.bind(str(CONTROL_SOCKET))
        finally:
            os.umask(old_umask)
        listener.listen(4)
        listener.setblocking(False)
        return listener

    def temperature(self) -> int | None:
        value = None
        if self.temp_input is not None:
            value = common.read_temperature_c(self.temp_input)
        now = time.monotonic()
        if value is None and now >= self.next_sensor_search:
            # The sensor moved (driver reload) or never existed: look again,
            # but at most once a minute so a machine without one stays cheap.
            self.next_sensor_search = now + 60.0
            self.temp_input = common.find_temperature_input(HWMON_DIR)
            if self.temp_input is not None:
                value = common.read_temperature_c(self.temp_input)
        return value

    def facts(self) -> engine_mod.Facts:
        now = time.monotonic()
        on_ac, battery = self.power.read(now)
        game = self.games.poll(now, on_ac)
        if (game is None) != (self.game is None):
            if game is not None:
                self.log.info(
                    f"Steam game detected: appid={game['appid']} pid={game['pid']} "
                    f"comm={game['comm']}"
                )
            else:
                self.log.info("Steam game ended")
        self.game = game
        return engine_mod.Facts(
            now=now,
            on_ac=on_ac,
            battery_percent=battery,
            busy_percent=self.sampler.busy_percent(),
            load1=engine_mod.load1(),
            game_running=game is not None,
            temperature_c=self.temperature(),
        )

    def check_resume(self) -> None:
        boot = time.clock_gettime(time.CLOCK_BOOTTIME)
        mono = time.monotonic()
        slept = (boot - self.last_boot) - (mono - self.last_mono)
        self.last_boot, self.last_mono = boot, mono
        if slept > RESUME_GAP_S:
            self.log.info(
                f"Resumed after {slept:.0f}s asleep; reasserting every setting."
            )
            self.power.dirty = True
            self.engine.request_reassert(mono, followup=True)

    def check_config(self, now: float) -> None:
        if now < self.next_config_check:
            return
        self.next_config_check = now + CONFIG_CHECK_S
        mtime = config_mtime()
        if mtime != self.config_mtime:
            self.config_mtime = mtime
            self.log.info(f"{PROFILE_CONF} changed; reloading it.")
            self.engine.set_config(profiles.ProfileConfig.load(PROFILE_CONF))

    def refresh(self) -> None:
        """Reconcile now, reusing the last CPU sample."""
        last = self.engine.last_facts
        if last is None:
            self.engine.step(self.facts())
            return
        now = time.monotonic()
        on_ac, battery = self.power.read(now)
        self.engine.step(
            engine_mod.Facts(
                now=now,
                on_ac=on_ac,
                battery_percent=battery,
                busy_percent=last.busy_percent,
                load1=last.load1,
                game_running=last.game_running,
                temperature_c=last.temperature_c,
            ),
            sample_idle=False,
        )

    def handle(self, request: dict[str, typing.Any]) -> dict[str, typing.Any]:
        cmd = request.get("cmd")
        if cmd == "reassert":
            self.engine.request_reassert(time.monotonic())
            self.refresh()
            return {"ok": True, "message": "Every setting was rewritten."}
        if cmd == "auto":
            self.engine.set_manual(None)
        elif cmd == "set" and request.get("profile") in profiles.PROFILE_NAMES:
            self.engine.set_manual(str(request["profile"]))
        else:
            return {"ok": False, "message": f"unknown request {request!r}"}
        self.refresh()
        base = self.engine.base
        if base is None:
            return {"ok": False, "message": "no profile could be applied"}
        profile, source = base
        wanted = request.get("profile")
        if cmd == "set" and profile.name != wanted:
            battery = (
                self.engine.last_facts.battery_percent
                if self.engine.last_facts
                else None
            )
            return {
                "ok": False,
                "message": f"battery is low ({battery}%): battery-saver stays in force "
                f"and '{wanted}' was not applied.",
            }
        message = engine_mod.describe(profile)
        if cmd == "auto" and source == profiles.SOURCE_GAME:
            message += " A Steam game is running."
        return {"ok": True, "message": message}

    def serve_one(self) -> None:
        try:
            conn, _ = self.listener.accept()
        except BlockingIOError:
            return
        with conn:
            conn.settimeout(2)
            try:
                if peer_uid(conn) != 0:
                    reply: dict[str, typing.Any] = {
                        "ok": False,
                        "message": "root is required",
                    }
                else:
                    data = b""
                    while not data.endswith(b"\n") and len(data) < 4096:
                        chunk = conn.recv(4096)
                        if not chunk:
                            break
                        data += chunk
                    if not data.strip():
                        # A liveness probe (daemon_reachable) connects and
                        # hangs up without asking anything.
                        return
                    try:
                        request = json.loads(data.decode())
                    except ValueError:
                        request = {}
                    if not isinstance(request, dict):
                        request = {}
                    reply = self.handle(request)
                conn.sendall(json.dumps(reply).encode() + b"\n")
            except (BrokenPipeError, ConnectionResetError):
                pass  # The client gave up waiting; nothing to report.
            except OSError as exc:
                self.log.warn(f"control request failed: {exc}")

    def stop(self, *_: object) -> None:
        self.stopping = True

    def run(self) -> int:
        signal.signal(signal.SIGTERM, self.stop)
        signal.signal(signal.SIGINT, self.stop)
        self.engine.step(self.facts())
        sd_notify("READY=1")
        next_tick = time.monotonic() + self.tick_s
        try:
            while not self.stopping:
                timeout = max(0.0, next_tick - time.monotonic())
                watched = [self.listener]
                if self.power.sock is not None:
                    watched.append(self.power.sock)
                ready, _, _ = select.select(watched, [], [], timeout)
                if self.power.sock is not None and self.power.sock in ready:
                    self.power.drain()
                if self.listener in ready:
                    self.serve_one()
                now = time.monotonic()
                if now >= next_tick and not self.stopping:
                    self.check_resume()
                    self.check_config(now)
                    self.engine.step(self.facts())
                    sd_notify("WATCHDOG=1")
                    next_tick = max(next_tick + self.tick_s, now + self.tick_s / 2)
        finally:
            sd_notify("STOPPING=1")
            self.engine.leave_idle()
            self.listener.close()
            self.power.close()
            try:
                CONTROL_SOCKET.unlink()
            except OSError:
                pass
        return 0


# --- one-shot and client commands -----------------------------------------


def apply_once(profile: str | None) -> int:
    if daemon_reachable():
        die(
            "the service is running and owns the power settings; use "
            f"'{PROG} {profile or 'auto'}' instead of apply-once"
        )
    check_hardware()
    log = engine_mod.Log(PROG)
    engine = build_engine(log, profiles.IdleSettings(enabled=False), profile)
    engine.step(
        engine_mod.Facts(
            now=time.monotonic(),
            on_ac=common.on_ac_power(POWER_SUPPLY_DIR),
            battery_percent=common.battery_capacity(POWER_SUPPLY_DIR),
            busy_percent=100.0,
            load1=0.0,
            game_running=False,
            temperature_c=common.cpu_temperature_c(HWMON_DIR),
        )
    )
    if profile is not None and engine.base is not None:
        if engine.base[0].name != profile:
            print(
                f"{PROG}: battery is low: battery-saver stays in force and "
                f"'{profile}' was not applied.",
                file=sys.stderr,
            )
            return 1
    return 0


def reexec_via_sudo(argv: list[str]) -> typing.NoReturn:
    prog = argv[0] if argv else PROG
    if "/" in prog and not os.path.isabs(prog):
        prog = os.path.abspath(prog)
    cmd = ["sudo", "env"]
    for key in SUDO_PRESERVE_ENV:
        if key in os.environ:
            cmd.append(f"{key}={os.environ[key]}")
    cmd.append(prog)
    cmd.extend(argv[1:])
    try:
        os.execvp("sudo", cmd)
    except OSError:
        die("sudo is required but was not found; re-run as root")
    raise SystemExit(1)  # pragma: no cover


def main(argv: list[str]) -> int:
    command = argv[0] if argv else "auto"
    if command in ("--help", "-h"):
        usage()
        return 0
    if command == "--version":
        print(f"{PROG} {ELITEBOOK_VERSION}")
        return 0
    if command == "status":
        if len(argv) > 1 and argv[1] == "--json":
            print_status_json()
        else:
            print_status()
        return 0
    if command == "--check-hardware":
        described = check_hardware()
        if described == "forced":
            print("Hardware guard skipped: ELITEBOOK_THERMAL_FORCE is set.")
        else:
            print(f"Supported hardware detected: {described}.")
        return 0

    root_commands = (
        "daemon",
        "apply-once",
        "reassert",
        "auto",
        *profiles.PROFILE_NAMES,
    )
    if command not in root_commands:
        usage()
        return 2
    if os.geteuid() != 0:
        reexec_via_sudo(sys.argv)

    if command == "daemon":
        try:
            daemon = Daemon()
        except SystemExit as exc:
            # Unsupported hardware or a bad RYZENADJ path will not fix itself
            # on a restart; EX_CONFIG tells systemd to stop retrying.
            if exc.code == 1:
                raise SystemExit(EX_CONFIG) from None
            raise
        return daemon.run()
    if command == "apply-once":
        wanted = argv[1] if len(argv) > 1 else "auto"
        if wanted != "auto" and wanted not in profiles.PROFILE_NAMES:
            usage()
            return 2
        return apply_once(None if wanted == "auto" else wanted)
    if command == "reassert":
        reply = send_request({"cmd": "reassert"})
    elif command == "auto":
        reply = send_request({"cmd": "auto"})
    else:
        reply = send_request({"cmd": "set", "profile": command})
    stream = sys.stdout if reply.get("ok") else sys.stderr
    print(str(reply.get("message", "")), file=stream)
    return 0 if reply.get("ok") else 1


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
