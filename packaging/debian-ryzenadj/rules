#!/usr/bin/make -f
# SPDX-License-Identifier: GPL-3.0-or-later
#
# Mirrors packaging/rpm/ryzenadj.spec: configure with CMake, build, then
# install the single binary. Upstream has no install target worth using, so
# the binary is placed explicitly, exactly as the RPM does.

export DH_VERBOSE = 1

%:
	dh $@

override_dh_auto_configure:
	cmake -S . -B build -DCMAKE_BUILD_TYPE=Release

override_dh_auto_build:
	cmake --build build --parallel

override_dh_auto_install:
	install -D -m 0755 build/ryzenadj debian/ryzenadj/usr/bin/ryzenadj

override_dh_auto_test:
	test -x build/ryzenadj

override_dh_auto_clean:
	rm -rf build
