#!/bin/sh
# SPDX-License-Identifier: GPL-3.0-or-later
set -e

if [ "$1" = "configure" ] && [ -e /usr/local/sbin/elitebook-thermal-profile ]; then
  cat >&2 <<'EOF'

WARNING: a source installation is also present.

  /usr/local/sbin/elitebook-thermal-profile

Its units in /etc/systemd/system take precedence over the ones this package
installs, so that copy keeps running and this package will not be the code in
use. Remove it with the installer from the source tree:

  sudo ./scripts/install.sh --uninstall

EOF
fi

if [ "$1" = "configure" ]; then
  # Earlier releases shipped separate watcher units. The daemon replaces them,
  # and the old units would otherwise keep running after the upgrade.
  systemctl disable --now elitebook-idle-watcher.service elitebook-steam-game-watcher.service >/dev/null 2>&1 || true
  rm -f /etc/systemd/system/multi-user.target.wants/elitebook-idle-watcher.service \
    /etc/systemd/system/multi-user.target.wants/elitebook-steam-game-watcher.service
fi

# Before 1.0 the service was a oneshot that stayed "active (exited)". On an
# upgrade it has to be restarted, or the daemon would not run until reboot
# and nothing would follow the power source in the meantime. A fresh install
# still enables nothing.
if [ "$1" = "configure" ] && [ -n "$2" ] && dpkg --compare-versions "$2" lt 1.0.0; then
  systemctl daemon-reload >/dev/null 2>&1 || true
  if systemctl is-enabled --quiet elitebook-thermal-profile.service 2>/dev/null; then
    systemctl restart elitebook-thermal-profile.service || true
  fi
fi

# The D-Bus front end is started on demand and then stays up. A copy that
# is already running keeps the old code until restarted. For a unit with no
# [Install] section, deb-systemd-invoke restart acts only on a running copy,
# so nothing starts on a fresh install.
if [ "$1" = "configure" ] && [ -n "$2" ] && [ -d /run/systemd/system ]; then
  deb-systemd-invoke restart elitebook-thermal-profile-dbus.service >/dev/null 2>&1 || true
fi

if [ "$1" = "configure" ]; then
  cat <<'EOF'
elitebook-thermal-profile installed.

Nothing has been enabled. Check that your machine is on the supported hardware
list, then enable the units explicitly:
  sudo systemctl enable --now elitebook-thermal-profile.service
  sudo systemctl enable --now elitebook-power-guard.timer
  sudo systemctl start elitebook-power-guard.service

The daemon also runs the idle overlay and Steam game detection. To switch
either off, add Environment=ELITEBOOK_IDLE_OVERLAY=0 or
Environment=ELITEBOOK_STEAM_DETECTION=0 under [Service] in a drop-in for
elitebook-thermal-profile.service.

Full SMU control needs RyzenAdj, which Debian and Ubuntu do not package.
Without it, only EPP, boost, and CPU frequency controls apply.

Secure Boot puts the kernel in lockdown, which blocks the SMU writes this
package is built around. Check with: cat /sys/kernel/security/lockdown
EOF
fi

#DEBHELPER#

exit 0
