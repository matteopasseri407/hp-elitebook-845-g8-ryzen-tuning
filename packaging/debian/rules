#!/usr/bin/make -f
# SPDX-License-Identifier: GPL-3.0-or-later
#
# Mirrors packaging/rpm/elitebook-thermal-profile.spec: the same files, moved
# from the source installer's /usr/local/sbin layout into distribution paths,
# with the same rule that installing must never start hardware tuning.

export DH_VERBOSE = 1

EXTENSION_UUID = elitebook-thermal-profile@matteopasseri.github.io
PKG = debian/elitebook-thermal-profile
GNOME_PKG = debian/gnome-shell-extension-elitebook-thermal-profile

BINDIR = /usr/bin
LIBDIR = /usr/lib/elitebook-thermal-profile
UNITDIR = /usr/lib/systemd/system
EXTDIR = /usr/share/gnome-shell/extensions

%:
	dh $@

# Nothing to compile: shell scripts, Python modules, and GNOME Shell files.
override_dh_auto_build:

override_dh_auto_test:
	python3 -m py_compile \
		src/elitebook-thermal-profile \
		src/elitebook_common.py \
		src/elitebook_profiles.py \
		src/elitebook_engine.py \
		src/elitebook-power-guard

override_dh_auto_install:
	# The hibernate preflight is intentionally absent: it inspects Fedora-style
	# boot entries with grubby and checks an SELinux label.
	install -D -m 0755 src/elitebook-thermal-profile $(PKG)$(BINDIR)/elitebook-thermal-profile
	install -D -m 0644 src/elitebook_common.py $(PKG)$(LIBDIR)/elitebook_common.py
	install -D -m 0644 src/elitebook_profiles.py $(PKG)$(LIBDIR)/elitebook_profiles.py
	install -D -m 0644 src/elitebook_engine.py $(PKG)$(LIBDIR)/elitebook_engine.py
	install -D -m 0755 src/elitebook-power-guard $(PKG)$(BINDIR)/elitebook-power-guard

	install -D -m 0644 systemd/elitebook-thermal-profile.service $(PKG)$(UNITDIR)/elitebook-thermal-profile.service
	install -D -m 0644 systemd/elitebook-power-guard.service $(PKG)$(UNITDIR)/elitebook-power-guard.service
	install -D -m 0644 systemd/elitebook-power-guard.timer $(PKG)$(UNITDIR)/elitebook-power-guard.timer

	# Profile overrides ship fully commented out, so the file does nothing
	# until edited. Anything under /etc becomes a dpkg conffile, so those
	# edits survive upgrades, which is the point of shipping it.
	install -D -m 0644 config/profiles.conf.example $(PKG)/etc/elitebook-thermal-profile/profiles.conf

	install -d $(GNOME_PKG)$(EXTDIR)
	cp -a gnome-extension/$(EXTENSION_UUID) $(GNOME_PKG)$(EXTDIR)/

	# Rewrite the source-installer paths baked into units and helper scripts.
	sed -i -e 's#/usr/local/sbin#$(BINDIR)#g' \
		$(PKG)$(UNITDIR)/elitebook-*.service
	sed -i -e 's#/usr/local/sbin#$(BINDIR)#g' \
		$(PKG)$(BINDIR)/elitebook-power-guard
	sed -i -e 's#/usr/local/sbin/elitebook-thermal-profile#$(BINDIR)/elitebook-thermal-profile#g' \
		$(GNOME_PKG)$(EXTDIR)/$(EXTENSION_UUID)/extension.js

# Units ship disabled and stopped. Tuning hardware is an explicit decision the
# user makes after checking the supported hardware table, never a side effect
# of installing a package.
override_dh_installsystemd:
	dh_installsystemd --no-enable --no-start
